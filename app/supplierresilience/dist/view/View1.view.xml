<mvc:View
    controllerName="supplierresilience.controller.View1"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">
    <Page showHeader="false" enableScrolling="false">
        <content>
            <tnt:ToolPage sideExpanded="true">
                <tnt:header>
                    <tnt:ToolHeader>
                        <Title text="SUPPLIER RESILIENCE" level="H1" />
                        <ToolbarSpacer />
                        <Text text="Resilience Copilot" />
                    </tnt:ToolHeader>
                </tnt:header>
                <tnt:sideContent>
                    <tnt:SideNavigation id="sideNavigation" expanded="true" itemSelect="onNavSelect">
                        <tnt:NavigationList>
                            <!-- MONITOR group -->
                            <tnt:NavigationListItem text="MONITOR" enabled="false" />
                            <tnt:NavigationListItem key="control" text="News Feed" icon="sap-icon://home" />
                            <tnt:NavigationListItem key="caseDashboard" text="Case Dashboard" icon="sap-icon://batch-payments" />
                            <tnt:NavigationListItem key="agentDisruptions" text="Disruptions" icon="sap-icon://warning2" enabled="{dashboard>/disruptionsEnabled}" />

                            <!-- ASSESS group -->
                            <tnt:NavigationListItem text="ASSESS" enabled="false" />
                            <tnt:NavigationListItem key="riskAssessment" text="Risk Assessment" icon="sap-icon://alert" />
                            <tnt:NavigationListItem key="survivalPlanning" text="Survival Planning" icon="sap-icon://activity-items" />

                            <!-- ACT group -->
                            <tnt:NavigationListItem text="ACT" enabled="false" />
                            <tnt:NavigationListItem key="approvals" text="Recommendations" icon="sap-icon://approvals" />
                            <tnt:NavigationListItem key="planning" text="Execution" icon="sap-icon://process" />

                            <!-- TRACK group -->
                            <tnt:NavigationListItem text="TRACK" enabled="false" />
                            <tnt:NavigationListItem key="audit" text="Monitoring" icon="sap-icon://history" />
                        </tnt:NavigationList>
                    </tnt:SideNavigation>
                </tnt:sideContent>
                <tnt:mainContents>
                    <ScrollContainer vertical="true" height="100%">
                        <VBox class="sapUiSmallMargin">

                            <VBox id="dashboardView" visible="true">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.ControlTowerHome" type="XML" />
                            </VBox>

                            <VBox id="riskAssessmentView" visible="false">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.RiskAssessment" type="XML" />
                            </VBox>

                            <VBox id="survivalPlanningView" visible="false">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.SurvivalPlanning" type="XML" />
                            </VBox>

                            <VBox id="caseDashboardView" visible="false">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.CaseDashboard" type="XML" />
                            </VBox>

                            <VBox id="recommendationsView" visible="false">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.Recommendations" type="XML" />
                            </VBox>

                            <VBox id="executionView" visible="false">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.Execution" type="XML" />
                            </VBox>

                            <VBox id="monitoringView" visible="false">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.Monitoring" type="XML" />
                            </VBox>

                            <VBox id="agentDisruptionsView" visible="false">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.AgentDisruptions" type="XML" />
                            </VBox>

                        </VBox>
                    </ScrollContainer>
                </tnt:mainContents>
            </tnt:ToolPage>
        </content>
    </Page>
</mvc:View>
