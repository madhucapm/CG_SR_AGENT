<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Survival Planning Dashboard. sap_horizon default theme. -->
    <VBox width="100%">

        <Toolbar design="Transparent">
            <Title text="Survival Planning" level="H2" />
        </Toolbar>
        <Text text="Coverage analysis, time-to-survive, recovery gaps and shortfall quantification.  Data sourced from S/4HANA via Survival Planner agent." class="sapUiSmallMarginBottom" />

        <Toolbar design="Solid" class="sapUiSmallMarginBottom">
            <Label text="CASE ID" />
            <Select
                selectedKey="{dashboard>/selectedCaseId}"
                change=".onCaseDropdownChange"
                forceSelection="false"
                autoAdjustWidth="true"
                items="{caseHierarchy>/availableCases}">
                <core:Item key="{caseHierarchy>caseId}"
                           text="{= ${caseHierarchy>caseId} + (${caseHierarchy>eventTitle} ? ' — ' + ${caseHierarchy>eventTitle} : '')}" />
            </Select>
            <Text text="No cases available. Investigate an event in News Feed to create a case."
                  visible="{= ${caseHierarchy>/availableCases}.length === 0 }" />
        </Toolbar>

        <HBox width="100%" class="sapUiSmallMarginBottom">
            <GenericTile header="CRITICAL ITEMS" subheader="{survivalPlanning>/kpi/criticalItems/sub}" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent><NumericContent value="{survivalPlanning>/kpi/criticalItems/value}" valueColor="Error" /></TileContent>
            </GenericTile>
            <GenericTile header="AVG COVERAGE" subheader="{survivalPlanning>/kpi/avgCoverage/sub}" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent><NumericContent value="{survivalPlanning>/kpi/avgCoverage/value}" valueColor="Critical" /></TileContent>
            </GenericTile>
            <GenericTile header="WORST GAP" subheader="{survivalPlanning>/kpi/worstGap/sub}" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent><NumericContent value="{survivalPlanning>/kpi/worstGap/value}" valueColor="Neutral" /></TileContent>
            </GenericTile>
            <GenericTile header="TOTAL SHORTFALL" subheader="{survivalPlanning>/kpi/totalShortfall/sub}" frameType="OneByOne">
                <TileContent><NumericContent value="{survivalPlanning>/kpi/totalShortfall/value}" /></TileContent>
            </GenericTile>
        </HBox>

        <Panel width="100%" expandable="false">
            <headerToolbar>
                <Toolbar>
                    <Title text="MATERIAL COVERAGE ANALYSIS" level="H4" />
                    <ToolbarSpacer />
                    <Text text="S/4HANA Survival Planner (SVP)" />
                </Toolbar>
            </headerToolbar>
            <Table items="{survivalPlanning>/materials}"
                   showSeparators="Inner" fixedLayout="false"
                   noDataText="No material coverage data. Select a case and run the Survival Planner agent to populate.">
                <columns>
                    <Column width="14%"><Text text="MATERIAL" /></Column>
                    <Column width="12%"><Text text="PLANT" /></Column>
                    <Column width="11%" hAlign="Center"><Text text="TTS (WEEKS)" /></Column>
                    <Column width="11%" hAlign="Center"><Text text="TTR (WEEKS)" /></Column>
                    <Column width="11%" hAlign="Center"><Text text="GAP (WEEKS)" /></Column>
                    <Column width="13%" hAlign="Center"><Text text="SHORTFALL" /></Column>
                    <Column width="10%" hAlign="Center"><Text text="CONFIDENCE" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{survivalPlanning>material}" />
                            <Text text="{survivalPlanning>plant}" />
                            <ObjectStatus text="{survivalPlanning>timeToSurvive}"
                                  state="{= ${survivalPlanning>ttsWeeks} &lt; 2 ? 'Error' : ${survivalPlanning>ttsWeeks} &lt; 4 ? 'Warning' : 'Success' }" />
                            <Text text="{survivalPlanning>recovery}" />
                            <ObjectStatus text="{survivalPlanning>gap}"
                                  state="{= ${survivalPlanning>gapWeeks} > 2 ? 'Error' : ${survivalPlanning>gapWeeks} > 0 ? 'Warning' : 'Success' }" />
                            <Text text="{survivalPlanning>shortfall}" />
                            <ObjectStatus text="{survivalPlanning>confidence}"
                                  state="{= ${survivalPlanning>confidence} === 'HIGH' ? 'Success' : ${survivalPlanning>confidence} === 'MEDIUM' ? 'Warning' : 'Error' }" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>

    </VBox>
</core:FragmentDefinition>
