<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Monitoring — Case Timeline. Populated dynamically from getCaseHistory + getCaseHierarchy. -->
    <VBox width="100%">

        <Toolbar design="Transparent">
            <Title text="Monitoring — Case Timeline" level="H2" />
        </Toolbar>
        <Text text="Agent actions and completion statuses for the active case." class="sapUiSmallMarginBottom" />

        <Toolbar design="Solid" class="sapUiSmallMarginBottom">
            <Label text="CASE ID" />
            <Select
                selectedKey="{dashboard>/selectedCaseId}"
                change=".onCaseDropdownChange"
                forceSelection="false"
                autoAdjustWidth="true"
                items="{caseHierarchy>/availableCases}">
                <core:Item key="{caseHierarchy>caseId}"
                           text="{= ${caseHierarchy>caseId} + (${caseHierarchy>eventTitle} ? ' — ' + ${caseHierarchy>eventTitle} : '')}" />
            </Select>
            <Text text="No cases available. Investigate an event in News Feed to create a case."
                  visible="{= ${caseHierarchy>/availableCases}.length === 0 }" />
        </Toolbar>

        <!-- CASE HEADER -->
        <Panel class="sapUiSmallMarginBottom">
            <headerToolbar>
                <Toolbar>
                    <Title text="{monitoringModel>/case/caseId}" level="H3" />
                    <ToolbarSpacer />
                </Toolbar>
            </headerToolbar>
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <Label text="EVENT" class="sapUiSmallMarginEnd" />
                <Text text="{monitoringModel>/case/event}" />
            </HBox>
            <HBox alignItems="Center">
                <ObjectStatus text="{monitoringModel>/case/severity}" state="{= ${monitoringModel>/case/severity} === 'CRITICAL' ? 'Error' : ${monitoringModel>/case/severity} === 'HIGH' ? 'Warning' : 'Information' }" class="sapUiSmallMarginEnd" />
                <ObjectStatus text="{monitoringModel>/case/classification}" state="{= ${monitoringModel>/case/classification} === 'COMPLETE INTERRUPTION' ? 'Error' : 'Warning' }" />
            </HBox>
        </Panel>

        <!-- MAIN CONTENT -->
        <HBox width="100%">

            <!-- LEFT: Agent Activity -->
            <Panel width="100%" expandable="false">
                <headerToolbar><Toolbar><Title text="AGENT ACTIVITY" level="H4" /></Toolbar></headerToolbar>
                <Text text="No agent activity recorded for this case yet. Run agents from the Disruptions tab." visible="{= ${monitoringModel>/activities}.length === 0 }" class="sapUiSmallMargin" />
                <List items="{monitoringModel>/activities}" showSeparators="Inner">
                    <CustomListItem>
                        <HBox alignItems="Center" class="sapUiTinyMarginTopBottom">
                            <core:Icon src="sap-icon://circle-task-2"
                                color="{= ${monitoringModel>status} === 'completed' ? 'Positive' : 'Default' }"
                                class="sapUiSmallMarginEnd" />
                            <VBox width="100%">
                                <HBox alignItems="Center" justifyContent="SpaceBetween">
                                    <Text text="{monitoringModel>agent}" />
                                    <Text text="{monitoringModel>time}" />
                                </HBox>
                                <Title text="{monitoringModel>title}" level="H5" />
                                <Text text="{monitoringModel>description}" wrapping="true" />
                            </VBox>
                        </HBox>
                    </CustomListItem>
                </List>
            </Panel>

            <!-- RIGHT: Case Details + Agent Status -->
            <VBox class="sapUiSmallMarginStart" width="20rem">
                <Panel class="sapUiSmallMarginBottom" expandable="false">
                    <headerToolbar><Toolbar><Title text="CASE DETAILS" level="H4" /></Toolbar></headerToolbar>
                    <VBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Case ID" class="sapUiSmallMarginEnd" width="6rem" /><Text text="{monitoringModel>/case/caseId}" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Event" class="sapUiSmallMarginEnd" width="6rem" /><Text text="{monitoringModel>/case/event}" wrapping="true" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Severity" class="sapUiSmallMarginEnd" width="6rem" /><ObjectStatus text="{monitoringModel>/case/severity}" state="{= ${monitoringModel>/case/severity} === 'CRITICAL' ? 'Error' : ${monitoringModel>/case/severity} === 'HIGH' ? 'Warning' : 'Information' }" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Classification" class="sapUiSmallMarginEnd" width="6rem" /><Text text="{monitoringModel>/case/classification}" /></HBox>
                    </VBox>
                </Panel>

                <Panel class="sapUiSmallMarginBottom" expandable="false">
                    <headerToolbar><Toolbar><Title text="AGENT STATUS" level="H4" /></Toolbar></headerToolbar>
                    <List items="{monitoringModel>/agentStatuses}" showSeparators="Inner">
                        <StandardListItem
                            title="{monitoringModel>name}"
                            info="{= ${monitoringModel>status} === 'completed' ? 'Completed' : ${monitoringModel>status} === 'pending' ? 'Running' : 'Not Run' }"
                            infoState="{= ${monitoringModel>status} === 'completed' ? 'Success' : ${monitoringModel>status} === 'pending' ? 'Warning' : 'None' }" />
                    </List>
                </Panel>

                <MessageStrip text="OPEN: AGENT COST DISPLAY IN REPORT" type="Information" showIcon="true" />
            </VBox>

        </HBox>

    </VBox>
</core:FragmentDefinition>
