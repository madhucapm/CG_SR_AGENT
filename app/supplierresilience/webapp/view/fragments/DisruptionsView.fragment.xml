<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Disruptions Analysis view — sap_horizon default theme -->
    <VBox>
        <!-- Back to Risk Feed header -->
        <VBox class="sapUiSmallMarginBottom">
            <Link text="\u2190 Back to Risk Feed" press=".onBackToRiskFeed" class="sapUiTinyMarginBottom" />
            <Panel visible="{= !!${disruptions>/selectedRisk}}">
                <HBox alignItems="Center" justifyContent="SpaceBetween">
                    <HBox alignItems="Center">
                        <core:Icon src="{disruptions>/selectedRisk/icon}" class="sapUiSmallMarginEnd" />
                        <VBox>
                            <Title text="{disruptions>/selectedRisk/title}" level="H4" wrapping="true" />
                            <Text text="{disruptions>/selectedRisk/description}" wrapping="true" />
                        </VBox>
                    </HBox>
                    <VBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <Label text="Risk Level" class="sapUiSmallMarginEnd" />
                            <ObjectStatus text="{disruptions>/selectedRisk/riskLevel}"
                                         state="{= ${disruptions>/selectedRisk/riskLevel} === 'Critical' ? 'Error' : ${disruptions>/selectedRisk/riskLevel} === 'High' ? 'Warning' : ${disruptions>/selectedRisk/riskLevel} === 'Medium' ? 'Information' : 'Success'}" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <Label text="Region" class="sapUiSmallMarginEnd" />
                            <Text text="{disruptions>/selectedRisk/region}" />
                        </HBox>
                        <HBox alignItems="Center">
                            <Label text="Time" class="sapUiSmallMarginEnd" />
                            <Text text="{disruptions>/selectedRisk/time}" />
                        </HBox>
                    </VBox>
                </HBox>
            </Panel>
        </VBox>

        <!-- Page header -->
        <HBox justifyContent="SpaceBetween" alignItems="End" class="sapUiSmallMarginBottom">
            <VBox>
                <Label text="DISRUPTION ANALYSIS" />
                <Title text="Coordinator Agent complete \u2014 case opened as CRITICAL priority." level="H2" />
                <Text text="3 affected purchase orders found. Early Warning, Survival Planner and Substitution Checker are ready to run \u2014 in any order, on any PO. The Buyer Agent unlocks once Survival Planner has run for a given PO." />
            </VBox>
        </HBox>

        <!-- Impact summary -->
        <Panel class="sapUiSmallMarginBottom">
            <headerToolbar><Toolbar><Title text="IMPACT SUMMARY" level="H4" /></Toolbar></headerToolbar>
            <HBox class="sapUiSmallMarginBottom">
                <VBox class="sapUiMediumMarginEnd">
                    <Label text="Suppliers" />
                    <ObjectNumber number="{disruptions>/result/summary/suppliers}" state="Error" />
                </VBox>
                <VBox class="sapUiMediumMarginEnd">
                    <Label text="POs" />
                    <ObjectNumber number="{disruptions>/result/summary/pos}" state="Warning" />
                </VBox>
                <VBox class="sapUiMediumMarginEnd">
                    <Label text="Plants" />
                    <ObjectNumber number="{disruptions>/result/summary/plants}" />
                </VBox>
                <VBox>
                    <Label text="SKUs" />
                    <ObjectNumber number="{disruptions>/result/summary/skus}" />
                </VBox>
            </HBox>
        </Panel>

        <!-- PO table -->
        <HBox width="100%">
            <Panel width="68%" class="sapUiSmallMarginEnd">
                <headerToolbar><Toolbar><Title text="AFFECTED PURCHASE ORDERS" level="H4" /></Toolbar></headerToolbar>
                <Table items="{disruptions>/result/pos}"
                       showSeparators="Inner"
                       noDataText="No POs. Select a risk from Global Risks card and click Investigate.">
                    <columns>
                        <Column width="15%"><Text text="PO" /></Column>
                        <Column width="20%"><Text text="MATERIAL" /></Column>
                        <Column width="15%"><Text text="PLANT" /></Column>
                        <Column width="25%"><Text text="AGENTS" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier title="{disruptions>poNumber}" />
                                <Text text="{disruptions>material}" />
                                <Text text="{disruptions>plant}" />
                                <HBox>
                                    <Button text="Early Warning" press=".onRunEarlyWarningOnPO" type="Transparent" class="sapUiTinyMarginEnd" />
                                    <Button text="Survival" press=".onRunSurvivalOnPO" type="Transparent" class="sapUiTinyMarginEnd" />
                                    <Button text="Substitution" press=".onRunSubstitutionOnPO" type="Transparent" class="sapUiTinyMarginEnd" />
                                    <Button text="Buyer" press=".onRunBuyerOnPO" type="Transparent" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

            <!-- Affected Suppliers -->
            <Panel width="32%">
                <headerToolbar><Toolbar><Title text="AFFECTED SUPPLIERS" level="H5" /></Toolbar></headerToolbar>
                <List
                    id="disruptionsSupplierList"
                    items="{disruptions>/result/affected_suppliers}"
                    noDataText="No affected suppliers. Select a risk from the Global Risks card and click Investigate to run an analysis."
                    showSeparators="Inner">
                    <CustomListItem>
                        <VBox class="sapUiTinyMarginTopBottom">
                            <HBox justifyContent="SpaceBetween" alignItems="Center">
                                <VBox>
                                    <Text text="{disruptions>name} ({disruptions>supplier_id})" />
                                    <Text text="{disruptions>address}" />
                                </VBox>
                                <ObjectStatus
                                    text="{= ${disruptions>distance_km} + ' km \u00b7 ' + ${disruptions>po_count} + ' PO(s)' }"
                                    state="{= ${disruptions>po_count} > 0 ? 'Warning' : 'None' }" />
                            </HBox>
                            <Table inset="true"
                                items="{ path: 'disruptions>purchase_orders', templateShareable: false }"
                                noDataText="No POs found in S/4HANA for this supplier.">
                                <columns>
                                    <Column><Text text="PO Number" /></Column>
                                    <Column><Text text="Item" /></Column>
                                    <Column><Text text="Material" /></Column>
                                    <Column><Text text="Plant" /></Column>
                                    <Column><Text text="SKU" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{disruptions>po_number}" />
                                            <Text text="{= ${disruptions>materials/0/item_no} || '\u2014' }" />
                                            <Text text="{= ${disruptions>materials/0/material} || '\u2014' }" />
                                            <Text text="{= ${disruptions>materials/0/plant} || '\u2014' }" />
                                            <Text text="{= ${disruptions>materials/0/sku} || '\u2014' }" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </CustomListItem>
                </List>
            </Panel>
        </HBox>

        <!-- Consolidated Recovery Plan -->
        <Panel class="sapUiSmallMarginTop">
            <headerToolbar><Toolbar><Title text="CONSOLIDATED RECOVERY PLAN" level="H5" /></Toolbar></headerToolbar>
            <Text text="No PO has a Buyer-approved plan yet. Run Survival Planner on at least one PO to generate a recovery recommendation." />
        </Panel>

    </VBox>
</core:FragmentDefinition>
