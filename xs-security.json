{
  "xsappname": "SupplierResilience-auth",
  "tenant-mode": "dedicated",
  "description": "Security profile for Supplier Resilience application",
  "scopes": [
    {
      "name": "$XSAPPNAME.user",
      "description": "User scope for accessing the application"
    },
    {
      "name": "$XSAPPNAME.admin",
      "description": "Admin scope for full access"
    },
    {
      "name": "uaa.user",
      "description": "UAA user scope"
    }
  ],
  "role-templates": [
    {
      "name": "Viewer",
      "description": "View data in the application",
      "scope-references": [
        "$XSAPPNAME.user"
      ]
    },
    {
      "name": "Admin",
      "description": "Full access to the application",
      "scope-references": [
        "$XSAPPNAME.user",
        "$XSAPPNAME.admin"
      ]
    },
    {
      "name": "Token_Exchange",
      "description": "UAA token exchange",
      "scope-references": [
        "uaa.user"
      ]
    }
  ],
  "oauth2-configuration": {
   "redirect-uris": [
 
  "https://*.cfapps.eu10-004.hana.ondemand.com/**",
  "https://*.cfapps.eu10.hana.ondemand.com/**"
],
    "system-attributes": []
  },
  "attributes": []
}
