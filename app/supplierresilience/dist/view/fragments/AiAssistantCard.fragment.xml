<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- AI Assistant / Case Creation panel — sap_horizon default theme.
         STATE 1 (initial): Case Creation + Agent Pipeline
         STATE 2 (impactPreview): Impact Preview + Early Warning Output
         STATE 3 (caseCreated): Case Created confirmation
    -->
    <Panel width="100%"
           busy="{= ${disruptions>/aiRiskState} === &apos;loading&apos; }"
           busyIndicatorDelay="0">

        <!-- STATE 1 — INITIAL -->
        <VBox visible="{= ${disruptions>/aiRiskState} !== &apos;impactPreview&apos; &amp;&amp; ${disruptions>/aiRiskState} !== &apos;creatingCase&apos; &amp;&amp; ${disruptions>/aiRiskState} !== &apos;caseCreated&apos; }" width="100%">
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <Title text="CASE CREATION" level="H3" class="sapUiSmallMarginEnd" />
                <ObjectStatus text="HUMAN-IN-THE-LOOP" state="Warning" />
            </HBox>
            <Text text="Select a disruption event to preview supplier impact. The Early Warning Agent runs automatically. A case is created only after you confirm the impact." class="sapUiSmallMarginBottom" />

            <Toolbar design="Transparent"><ToolbarSpacer /></Toolbar>

            <Title text="AGENT PIPELINE" level="H4" class="sapUiSmallMarginBottom" />
            <VBox>
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                    <Text text="Early Warning Agent (auto)" />
                </HBox>
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                    <Text text="Coordinator Agent (on confirm)" />
                </HBox>
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                    <Text text="Survival Planner Agent" />
                </HBox>
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                    <Text text="Substitution Agent" />
                </HBox>
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                    <Text text="Buyer Agent" />
                </HBox>
            </VBox>
        </VBox>


        <!-- STATE 2 — IMPACT PREVIEW -->
        <VBox visible="{= ${disruptions>/aiRiskState} === &apos;impactPreview&apos; || ${disruptions>/aiRiskState} === &apos;creatingCase&apos; }" width="100%">
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <Title text="IMPACT PREVIEW" level="H3" class="sapUiSmallMarginEnd" />
                <ObjectStatus text="HUMAN DECISION" state="Warning" />
            </HBox>

            <Title text="EVENT" level="H5" class="sapUiTinyMarginBottom" />
            <Text text="{disruptions>/selectedRisk/title}" class="sapUiSmallMarginBottom" />

            <Title text="TYPE" level="H5" class="sapUiTinyMarginBottom" />
            <Text text="{disruptions>/classifiedType}" class="sapUiSmallMarginBottom" />

            <Title text="EARLY WARNING OUTPUT" level="H5" class="sapUiTinyMarginBottom" />
            <VBox class="sapUiSmallMarginBottom">
                <HBox class="sapUiTinyMarginBottom"><Label text="Summary" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{disruptions>/earlyWarningOutput/summary}" wrapping="true" /></HBox>
            </VBox>

            <Title text="IMPACT METRICS" level="H5" class="sapUiTinyMarginBottom" />
            <HBox class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="Suppliers" />
                    <ObjectNumber number="{disruptions>/earlyWarningOutput/suppliers}" state="Error" />
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="POs" />
                    <ObjectNumber number="{disruptions>/earlyWarningOutput/pos}" state="Warning" />
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="Plants" />
                    <ObjectNumber number="{disruptions>/earlyWarningOutput/plants}" />
                </VBox>
                <VBox>
                    <Label text="SKUs" />
                    <ObjectNumber number="{disruptions>/earlyWarningOutput/skus}" />
                </VBox>
            </HBox>

            <Title text="IMPACT SCORE" level="H5" class="sapUiTinyMarginBottom" />
            <HBox class="sapUiSmallMarginBottom" alignItems="Center">
                <ObjectStatus text="{disruptions>/impactPreview/riskScore}" state="Error" class="sapUiSmallMarginEnd" />
            </HBox>

            <Title text="FINANCIAL IMPACT" level="H5" class="sapUiTinyMarginBottom" />
            <HBox class="sapUiSmallMarginBottom" alignItems="Center">
                <ObjectStatus text="{disruptions>/impactPreview/estimatedImpact}" state="Warning" class="sapUiSmallMarginEnd" />
            </HBox>

            <Toolbar design="Transparent"><ToolbarSpacer /></Toolbar>

            <MessageStrip text="Human decision required. Confirm supplier impact to trigger the Coordinator Agent, create a Case ID, and run downstream agents." type="Warning" showIcon="true" class="sapUiSmallMarginBottom" />

            <VBox>
                <Button text="Confirm Impact &amp; Create Case" press=".onConfirmImpact"
                        type="Emphasized" width="100%" class="sapUiTinyMarginBottom"
                        enabled="{= ${disruptions>/aiRiskState} !== &apos;creatingCase&apos; }"
                        busy="{= ${disruptions>/aiRiskState} === &apos;creatingCase&apos; }" />
                <Button text="Dismiss" press=".onDismissImpact" type="Transparent" width="100%"
                        enabled="{= ${disruptions>/aiRiskState} !== &apos;creatingCase&apos; }" />
            </VBox>
        </VBox>


        <!-- STATE 3 — CASE CREATED -->
        <VBox visible="{= ${disruptions>/aiRiskState} === &apos;caseCreated&apos; }" width="100%">
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <Title text="CASE CREATED" level="H3" class="sapUiSmallMarginEnd" />
                <ObjectStatus text="SUCCESS" state="Success" />
            </HBox>

            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://accept" color="Positive" class="sapUiSmallMarginEnd" />
                <Title text="Case #{disruptions>/createdCase/caseId}" level="H4" />
            </HBox>
            <Text text="{disruptions>/createdCase/eventTitle}" class="sapUiSmallMarginBottom" />

            <Title text="IMPACT" level="H5" class="sapUiTinyMarginBottom" />
            <VBox class="sapUiSmallMarginBottom">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                    <Label text="Suppliers:" class="sapUiSmallMarginEnd" />
                    <Text text="{disruptions>/createdCase/supplierSummary}" />
                </HBox>
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                    <Label text="POs:" class="sapUiSmallMarginEnd" />
                    <Text text="{disruptions>/createdCase/poSummary}" />
                </HBox>
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                    <Label text="Plants:" class="sapUiSmallMarginEnd" />
                    <Text text="{disruptions>/createdCase/plantSummary}" wrapping="true" />
                </HBox>
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                    <Label text="SKUs:" class="sapUiSmallMarginEnd" />
                    <Text text="{disruptions>/createdCase/skuSummary}" wrapping="true" />
                </HBox>
            </VBox>

            <Toolbar design="Transparent"><ToolbarSpacer /></Toolbar>

            <Button text="Open Case Dashboard \u2192" press=".onOpenCaseDashboard"
                    type="Emphasized" width="100%" />
        </VBox>

    </Panel>
</core:FragmentDefinition>
