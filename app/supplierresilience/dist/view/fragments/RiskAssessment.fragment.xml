<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Risk Assessment Dashboard. sap_horizon default theme. -->
    <VBox width="100%">

        <Toolbar design="Transparent">
            <Title text="Risk Assessment Dashboard" level="H2" />
        </Toolbar>
        <Text text="Early Warning Agent output — risk scores, severity and impact analysis." class="sapUiSmallMarginBottom" />

        <Toolbar design="Solid" class="sapUiSmallMarginBottom">
            <Label text="CASE ID" />
            <Select
                selectedKey="{dashboard>/selectedCaseId}"
                change=".onCaseDropdownChange"
                forceSelection="false"
                autoAdjustWidth="true"
                items="{caseHierarchy>/availableCases}">
                <core:Item key="{caseHierarchy>caseId}"
                           text="{caseHierarchy>caseId} — {caseHierarchy>eventTitle}" />
            </Select>
            <Text text="No cases available. Investigate an event in News Feed to create a case."
                  visible="{= ${caseHierarchy>/availableCases}.length === 0 }" />
        </Toolbar>

        <HBox width="100%" class="sapUiSmallMarginBottom">
            <GenericTile header="HIGHEST RISK" subheader="{riskAssessment>/kpi/highestRisk/supplier}" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent><NumericContent value="{riskAssessment>/kpi/highestRisk/value}" valueColor="Error" /></TileContent>
            </GenericTile>
            <GenericTile header="SUPPLIERS IMPACTED" subheader="{riskAssessment>/kpi/suppliersImpacted/sub}" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent><NumericContent value="{riskAssessment>/kpi/suppliersImpacted/value}" valueColor="Critical" /></TileContent>
            </GenericTile>
            <GenericTile header="POS AT RISK" subheader="{riskAssessment>/kpi/posAtRisk/sub}" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent><NumericContent value="{riskAssessment>/kpi/posAtRisk/value}" valueColor="Neutral" /></TileContent>
            </GenericTile>
            <GenericTile header="PLANTS" subheader="{riskAssessment>/kpi/plants/sub}" frameType="OneByOne">
                <TileContent><NumericContent value="{riskAssessment>/kpi/plants/value}" /></TileContent>
            </GenericTile>
        </HBox>

        <HBox width="100%">
            <Panel width="100%" expandable="false">
                <headerToolbar><Toolbar><Title text="SUPPLIER RISK TABLE" level="H4" /></Toolbar></headerToolbar>
                <Table items="{riskAssessment>/supplierRisks}"
                       showSeparators="Inner" fixedLayout="false"
                       noDataText="No supplier risk data available. Select a case to populate.">
                    <columns>
                        <Column width="14%"><Text text="SUPPLIER" /></Column>
                        <Column width="16%"><Text text="CLASSIFICATION" /></Column>
                        <Column width="10%" hAlign="Center"><Text text="RISK SCORE" /></Column>
                        <Column width="10%" hAlign="Center"><Text text="SEVERITY" /></Column>
                        <Column width="10%" hAlign="Center"><Text text="POs AT RISK" /></Column>
                        <Column width="20%" minScreenWidth="Tablet" demandPopin="true"><Text text="PLANTS" /></Column>
                        <Column width="20%" minScreenWidth="Tablet" demandPopin="true"><Text text="Materials" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{riskAssessment>supplier}" />
                                <ObjectStatus text="{riskAssessment>classification}" state="{= ${riskAssessment>classification} === 'COMPLETE INTERRUPTION' ? 'Error' : 'Warning' }" />
                                <ObjectNumber number="{riskAssessment>riskScore}" state="{= parseInt(${riskAssessment>riskScore}) >= 80 ? 'Error' : parseInt(${riskAssessment>riskScore}) >= 60 ? 'Warning' : 'None' }" />
                                <ObjectStatus text="{riskAssessment>severity}" state="{= ${riskAssessment>severity} === 'CRITICAL' ? 'Error' : ${riskAssessment>severity} === 'HIGH' ? 'Warning' : ${riskAssessment>severity} === 'MEDIUM' ? 'Information' : 'Success' }" />
                                <Text text="{riskAssessment>posAtRisk}" />
                                <Text text="{riskAssessment>plants}" wrapping="true" />
                                <Text text="{riskAssessment>materials}" wrapping="true" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

            <Panel class="sapUiSmallMarginStart" width="18rem" expandable="false">
                <headerToolbar><Toolbar><Title text="RISK MODEL" level="H4" /></Toolbar></headerToolbar>
                <VBox class="sapUiSmallMarginBottom">
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom"><ObjectStatus text="●" state="Error" class="sapUiTinyMarginEnd" /><Text text="Disruption severity" class="sapUiSmallMarginEnd" /><Text text="40%" /></HBox>
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom"><ObjectStatus text="●" state="Warning" class="sapUiTinyMarginEnd" /><Text text="Supplier concentration" class="sapUiSmallMarginEnd" /><Text text="25%" /></HBox>
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom"><ObjectStatus text="●" state="Information" class="sapUiTinyMarginEnd" /><Text text="Material criticality" class="sapUiSmallMarginEnd" /><Text text="20%" /></HBox>
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom"><ObjectStatus text="●" state="None" class="sapUiTinyMarginEnd" /><Text text="Lead time exposure" class="sapUiSmallMarginEnd" /><Text text="15%" /></HBox>
                </VBox>
                <Toolbar design="Transparent"><ToolbarSpacer /></Toolbar>
                <VBox>
                    <Title text="SEVERITY" level="H5" class="sapUiTinyMarginBottom" />
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom"><ObjectStatus text="●" state="Error" class="sapUiTinyMarginEnd" /><Text text="Critical" class="sapUiSmallMarginEnd" /><Text text="80–100" /></HBox>
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom"><ObjectStatus text="●" state="Warning" class="sapUiTinyMarginEnd" /><Text text="High" class="sapUiSmallMarginEnd" /><Text text="60–79" /></HBox>
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom"><ObjectStatus text="●" state="None" class="sapUiTinyMarginEnd" /><Text text="Medium" class="sapUiSmallMarginEnd" /><Text text="40–59" /></HBox>
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom"><ObjectStatus text="●" state="Success" class="sapUiTinyMarginEnd" /><Text text="Low" class="sapUiSmallMarginEnd" /><Text text="0–39" /></HBox>
                </VBox>
            </Panel>
        </HBox>
    </VBox>
</core:FragmentDefinition>
