<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!--
        Disruptions Analysis view.
        Displays results from the supplier_resilience_agent /analyze endpoint.
        Shows impact summary, affected suppliers, and affected POs.
    -->
    <VBox>
        <!-- Back to Risk Feed header -->
        <VBox class="disruptionsBackHeader sapUiSmallMarginBottom">
            <Link text="← Back to Risk Feed"
                  press=".onBackToRiskFeed"
                  class="sapUiTinyMarginBottom" />
            <!-- Display the selected risk in the same layout as the GlobalRisksCard row -->
            <HBox alignItems="Center" class="ctRiskItem ctRiskRow" justifyContent="SpaceBetween"
                  visible="{= !!${disruptions>/selectedRisk}}">
                <!-- Left: icon + title + description -->
                <HBox alignItems="Center" class="ctRiskLeft">
                    <VBox class="{disruptions>/selectedRisk/iconWrapClass}" alignItems="Center" justifyContent="Center">
                        <core:Icon src="{disruptions>/selectedRisk/icon}" class="{disruptions>/selectedRisk/iconClass}" />
                    </VBox>
                    <VBox class="ctRiskText">
                        <Title text="{disruptions>/selectedRisk/title}" level="H4" class="{disruptions>/selectedRisk/titleClass}" wrapping="true" />
                        <Text text="{disruptions>/selectedRisk/description}" class="ctRiskDescription" wrapping="true" />
                    </VBox>
                </HBox>
                <!-- Right: meta grid -->
                <HBox alignItems="Center" class="ctRiskRight">
                    <VBox class="ctRiskMeta">
                        <HBox alignItems="Center" class="ctRiskMetaRow">
                            <Label text="Risk Level" class="ctRiskMetaLabel" />
                            <ObjectStatus text="{disruptions>/selectedRisk/riskLevel}"
                                         state="{= ${disruptions>/selectedRisk/riskLevel} === 'Critical' ? 'Error' : ${disruptions>/selectedRisk/riskLevel} === 'High' ? 'Warning' : ${disruptions>/selectedRisk/riskLevel} === 'Medium' ? 'Information' : 'Success'}" />
                        </HBox>
                        <HBox alignItems="Center" class="ctRiskMetaRow">
                            <Label text="Region" class="ctRiskMetaLabel" />
                            <Text text="{disruptions>/selectedRisk/region}" class="ctRiskMetaValue" />
                        </HBox>
                        <HBox alignItems="Center" class="ctRiskMetaRow">
                            <Label text="Time" class="ctRiskMetaLabel" />
                            <Text text="{disruptions>/selectedRisk/time}" class="ctRiskMetaValue" />
                        </HBox>
                    </VBox>
                </HBox>
            </HBox>
        </VBox>

        <!-- Page header -->
        <HBox justifyContent="SpaceBetween" alignItems="End" class="pageIntro">
            <VBox>
                <Text text="DISRUPTION ANALYSIS" class="eyebrow" />
                <Title text="Coordinator Agent complete — case opened as CRITICAL priority." level="H2" />
                <Text text="3 affected purchase orders found. Early Warning, Survival Planner and Substitution Checker are ready to run — in any order, on any PO. The Buyer Agent unlocks once Survival Planner has run for a given PO."  />
            </VBox>
            <!-- <ObjectStatus text="{= ${disruptions>/hasResult} ? 'Analysis Complete' : 'Ready'}"
                          state="{= ${disruptions>/hasResult} ? 'Success' : 'Information'}"
                          icon="sap-icon://warning2" /> -->
        </HBox>

        <!-- Selected Risk Info (shown when a risk has been selected for investigation) -->
        <VBox visible="{= !!${disruptions>/selectedRisk}}" class="sapUiSmallMarginTop">
            <MessageStrip
                text="Analyzing: {disruptions>/selectedRisk/title} — Location: {disruptions>/selectedRisk/region} — Category: {disruptions>/selectedRisk/category}"
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom" />
        </VBox>

        <!-- No risk selected placeholder -->
        <!-- <VBox visible="{= !${disruptions>/selectedRisk} &amp;&amp; !${disruptions>/hasResult}}" class="sapUiMediumMarginTop">
            <MessageStrip
                text="Select a risk from the Global Risks list on the Control Tower, then click 'Investigate a Risk' in the AI Assistant to analyze its impact."
                type="Warning"
                showIcon="true" />
        </VBox> -->

        <!-- Impact scope section -->
        <VBox class="sapUiSmallMarginTop">
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://grid" class="sapUiTinyMarginEnd" />
                <Title text="Impact scope" level="H4" class="sapUiTinyMarginBegin" />
            </HBox>
            <!--
                Impact-scope cards. Populated by _computeDisruptionScope in the
                controller from the analyzeImpact response. When no analysis has
                been run yet the "scope" model defaults to zeros.
            -->
            <HBox justifyContent="SpaceBetween" wrap="Wrap">
                <VBox class="impactCard sapUiSmallMarginEnd sapUiSmallMarginBottom">
                    <Title text="{disruptions>/scope/poCount}" level="H3" />
                    <Text text="Purchase orders affected" class="impactLabel" />
                </VBox>
                <VBox class="impactCard sapUiSmallMarginEnd sapUiSmallMarginBottom">
                    <Title text="{disruptions>/scope/plantCount}" level="H3" />
                    <Text text="Plants affected" class="impactLabel" />
                </VBox>
                <VBox class="impactCard sapUiSmallMarginEnd sapUiSmallMarginBottom">
                    <Title text="{disruptions>/scope/skuCount}" level="H3" />
                    <Text text="SKUs at risk" class="impactLabel" />
                </VBox>
                <VBox class="impactCard sapUiSmallMarginEnd sapUiSmallMarginBottom">
                    <Title text="{disruptions>/scope/supplierCount}" level="H3" />
                    <Text text="Suppliers affected" class="impactLabel" />
                </VBox>
                <VBox class="impactCard sapUiSmallMarginEnd sapUiSmallMarginBottom">
                    <Title
                        text="{= ${disruptions>/selectedRisk/riskLevel} || '—' }"
                        level="H3" />
                    <Text text="Case priority" class="impactLabel" />
                </VBox>
                <VBox class="impactCard sapUiSmallMarginBottom">
                    <Title text="—" level="H3" />
                    <Text text="Avg. risk score" class="impactLabel" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Run agent buttons section -->
        <VBox class="sapUiSmallMarginTop sapUiSmallMarginBottom">
            <Text text="Run an agent across every ready PO..." class="sapUiSmallMarginBottom runAgentPrompt" />
            <HBox wrap="Wrap">
                <Button text="● Run Early Warning · 3 POs" type="Emphasized" class="agentRunBtn sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                <Button text="● Run Survival Planner · 3 POs" type="Emphasized" class="agentRunBtn sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                <Button text="● Run Substitution Checker · 3 POs" type="Emphasized" class="agentRunBtn sapUiTinyMarginBottom" />
            </HBox>
        </VBox>

        <!-- Purchase Orders + Consolidated Recovery Plan two-column layout -->
        <HBox width="100%" class="sapUiSmallMarginTop">
            <!-- Left: Purchase Orders table -->
            <VBox width="68%" class="poTableCard sapUiSmallMarginEnd">
                <Title text="PURCHASE ORDERS" level="H5" class="poTableTitle sapUiSmallMarginBottom" />
                <!-- Column headers -->
                <HBox class="poHeaderRow sapUiTinyMarginBottom" justifyContent="SpaceBetween" alignItems="Center">
                    <Text text="PO" class="poColHeader poColPO" />
                    <Text text="EARLY" class="poColHeader poColAgent" />
                    <Text text="SURVIVAL" class="poColHeader poColAgent" />
                    <Text text="SUB" class="poColHeader poColAgent" />
                    <Text text="BUYER" class="poColHeader poColAgent" />
                </HBox>
                <!--
                    Real supplier + PO list, bound to the analyzeImpact
                    response via disruptions>/result/affected_suppliers.
                    Each supplier renders as a header row with their POs
                    listed underneath. Materials/plants/SKUs are shown as
                    a compact meta line for each PO.
                -->
                <List
                    id="disruptionsSupplierList"
                    items="{disruptions>/result/affected_suppliers}"
                    noDataText="No affected suppliers. Select a risk from the Global Risks card and click Investigate to run an analysis."
                    showSeparators="Inner">
                    <CustomListItem>
                        <VBox class="poRow">
                            <!-- Supplier header -->
                            <HBox justifyContent="SpaceBetween" alignItems="Center">
                                <VBox>
                                    <Text
                                        text="{disruptions>name} ({disruptions>supplier_id})"
                                        class="poNumber" />
                                    <Text text="{disruptions>address}" class="poMaterial" />
                                </VBox>
                                <ObjectStatus
                                    text="{= ${disruptions>distance_km} + ' km · ' + ${disruptions>po_count} + ' PO(s)' }"
                                    state="{= ${disruptions>po_count} > 0 ? 'Warning' : 'None' }" />
                            </HBox>
                            <!-- Nested POs table -->
                            <Table
                                inset="true"
                                items="{
                                    path: 'disruptions>purchase_orders',
                                    templateShareable: false
                                }"
                                noDataText="No POs found in S/4HANA for this supplier.">
                                <columns>
                                    <Column><Text text="PO Number" /></Column>
                                    <Column><Text text="Item" /></Column>
                                    <Column><Text text="Material" /></Column>
                                    <Column><Text text="Plant" /></Column>
                                    <Column><Text text="SKU" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{disruptions>po_number}" />
                                            <!-- Show first material inline; multi-line items expand naturally -->
                                            <Text text="{= ${disruptions>materials/0/item_no}  || '—' }" />
                                            <Text text="{= ${disruptions>materials/0/material} || '—' }" />
                                            <Text text="{= ${disruptions>materials/0/plant}    || '—' }" />
                                            <Text text="{= ${disruptions>materials/0/sku}      || '—' }" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </CustomListItem>
                </List>
            </VBox>

            <!-- Right: Consolidated Recovery Plan -->
            <VBox width="32%" class="recoveryPlanCard">
                <Title text="CONSOLIDATED RECOVERY PLAN" level="H5" class="recoveryPlanTitle sapUiSmallMarginBottom" />
                <Text text="No PO has a Buyer-approved plan yet. Run Survival Planner on at least one PO to generate a recovery recommendation." class="recoveryPlanPlaceholder" />
            </VBox>
        </HBox>

    </VBox>
</core:FragmentDefinition>