<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Execution Tracking — Static prototype (MVP1). sap_horizon default theme. -->
    <VBox width="100%">

        <Toolbar design="Transparent">
            <Title text="Execution Tracking" level="H2" />
        </Toolbar>
        <Text text="Buyer Agent actions against Mock SAP — PO creation, stock transfers, confirmation." class="sapUiSmallMarginBottom" />

        <Toolbar design="Solid" class="sapUiSmallMarginBottom">
            <Label text="CASE ID" />
            <Select
                selectedKey="{dashboard>/selectedCaseId}"
                change=".onCaseDropdownChange"
                forceSelection="false"
                autoAdjustWidth="true"
                items="{caseHierarchy>/availableCases}">
                <core:Item key="{caseHierarchy>caseId}"
                           text="{caseHierarchy>caseId} — {caseHierarchy>eventTitle}" />
            </Select>
            <Text text="No cases available. Investigate an event in News Feed to create a case."
                  visible="{= ${caseHierarchy>/availableCases}.length === 0 }" />
        </Toolbar>

        <HBox width="100%" class="sapUiSmallMarginBottom">
            <GenericTile header="CONFIRMED" subheader="Executed in Mock SAP" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent><NumericContent value="2" valueColor="Good" /></TileContent>
            </GenericTile>
            <GenericTile header="SUBMITTED" subheader="Awaiting confirmation" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent><NumericContent value="1" valueColor="Neutral" /></TileContent>
            </GenericTile>
            <GenericTile header="PENDING" subheader="Queued" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent><NumericContent value="1" /></TileContent>
            </GenericTile>
            <GenericTile header="TOTAL AGENT COST" subheader="Buyer Agent (mock)" frameType="OneByOne">
                <TileContent><NumericContent value="$31" valueColor="Critical" /></TileContent>
            </GenericTile>
        </HBox>

        <Panel class="sapUiSmallMarginBottom">
            <headerToolbar>
                <Toolbar>
                    <Title text="EXECUTION ACTIONS" level="H4" />
                    <ToolbarSpacer />
                    <Text text="Click an Action ID to jump to its monitoring entry" />
                </Toolbar>
            </headerToolbar>
            <Table showSeparators="Inner" fixedLayout="false">
                <columns>
                    <Column width="10%"><Text text="ACTION ID" /></Column>
                    <Column width="12%"><Text text="TYPE" /></Column>
                    <Column width="13%"><Text text="MATERIAL" /></Column>
                    <Column width="12%"><Text text="SUPPLIER" /></Column>
                    <Column width="8%"><Text text="QTY" /></Column>
                    <Column width="10%"><Text text="SYSTEM" /></Column>
                    <Column width="8%"><Text text="COST" /></Column>
                    <Column width="12%"><Text text="STATUS" /></Column>
                    <Column width="8%"><Text text="TIME" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Link text="EXC-001" press=".onViewMonitoring" />
                            <Text text="Purchase Order" />
                            <Text text="PET Resin" />
                            <Text text="Indorama Ventures" />
                            <Text text="200 MT" />
                            <Text text="Mock S/4HANA" />
                            <Text text="$12" />
                            <ObjectStatus text="\u2713 Confirmed" state="Success" />
                            <Text text="14:22" />
                        </cells>
                    </ColumnListItem>
                    <ColumnListItem>
                        <cells>
                            <Link text="EXC-002" press=".onViewMonitoring" />
                            <Text text="Stock Transfer" />
                            <Text text="Aluminium Sheet" />
                            <Text text="Pune to Mumbai" />
                            <Text text="80 MT" />
                            <Text text="Mock S/4HANA" />
                            <Text text="$8" />
                            <ObjectStatus text="\u2713 Confirmed" state="Success" />
                            <Text text="14:35" />
                        </cells>
                    </ColumnListItem>
                    <ColumnListItem>
                        <cells>
                            <Link text="EXC-003" press=".onViewMonitoring" />
                            <Text text="Purchase Order" />
                            <Text text="PET Resin" />
                            <Text text="PolyAsia Corp" />
                            <Text text="50 MT" />
                            <Text text="Mock S/4HANA" />
                            <Text text="$11" />
                            <ObjectStatus text="\u21bb Submitted" state="Information" />
                            <Text text="15:01" />
                        </cells>
                    </ColumnListItem>
                    <ColumnListItem>
                        <cells>
                            <Link text="EXC-004" press=".onViewMonitoring" />
                            <Text text="Purchase Order" />
                            <Text text="Aluminium Coil" />
                            <Text text="Delta Metals" />
                            <Text text="95 MT" />
                            <Text text="Mock S/4HANA" />
                            <Text text="$\u2013" />
                            <ObjectStatus text="\u25cb Pending" state="None" />
                            <Text text="-" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>

        <Panel>
            <headerToolbar><Toolbar><Title text="PROGRESS" level="H4" /></Toolbar></headerToolbar>
            <HBox class="sapUiSmallMarginBottom">
                <VBox width="50%" class="sapUiSmallMarginEnd">
                    <Label text="Execution Progress" class="sapUiSmallMarginBottom" />
                    <ProgressIndicator percentValue="50" displayValue="2 of 4 confirmed" state="Success" />
                </VBox>
                <VBox width="50%">
                    <Label text="Coverage Recovery" class="sapUiSmallMarginBottom" />
                    <ProgressIndicator percentValue="76" displayValue="280 of 370 MT addressed" state="Information" />
                </VBox>
            </HBox>
        </Panel>

    </VBox>
</core:FragmentDefinition>
