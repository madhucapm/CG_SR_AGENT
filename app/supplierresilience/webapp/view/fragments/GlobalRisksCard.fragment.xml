<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Today's Global Supply Chain Risks — sap_horizon default theme -->
    <Panel busy="{dashboard>/globalRisksBusy}" busyIndicatorDelay="0">
        <headerToolbar>
            <Toolbar>
                <core:Icon src="sap-icon://globe" class="sapUiSmallMarginEnd" />
                <Title text="{i18n>ctGlobalRisksTitle}" level="H3" />
                <ToolbarSpacer />
                <Label text="Region" class="sapUiSmallMarginEnd" />
                <Select
                    id="globalRisksRegionSelect"
                    selectedKey="{globalRisks>/selectedRegion}"
                    change=".onRegionChange"
                    tooltip="Select region to filter global risks"
                    items="{globalRisks>/regions}">
                    <core:Item key="{globalRisks>key}" text="{globalRisks>text}" />
                </Select>
            </Toolbar>
        </headerToolbar>

        <List
            id="globalRisksList"
            items="{dashboard>/globalRisks}"
            showSeparators="Inner"
            noDataText="{i18n>ctNoRisks}"
            busy="{dashboard>/globalRisksBusy}"
            busyIndicatorDelay="0"
            updateFinished=".onRiskListUpdateFinished"
            itemPress=".onRiskPress">
            <CustomListItem type="Active">
                <VBox width="100%" class="sapUiTinyMarginTopBottom">
                    <HBox alignItems="Start" justifyContent="SpaceBetween">
                        <HBox alignItems="Start" width="70%">
                            <core:Icon src="{dashboard>icon}" class="sapUiSmallMarginEnd" />
                            <VBox>
                                <Title text="{dashboard>title}" level="H4" wrapping="true" />
                                <Text text="{dashboard>region} {dashboard>time}" class="sapUiTinyMarginBottom" />
                            </VBox>
                        </HBox>
                        <HBox alignItems="Center">
                            <ObjectStatus text="{dashboard>classification}"
                                state="{= ${dashboard>classification} === 'COMPLETE INTERRUPTION' ? 'Error' : ${dashboard>classification} === 'PARTIAL INTERRUPTION' ? 'Warning' : 'Information' }"
                                visible="{= !!${dashboard>classification} }"
                                class="sapUiTinyMarginEnd" />
                            <ObjectStatus text="{dashboard>riskLevel}"
                                state="{= ${dashboard>riskLevel} === 'Critical' ? 'Error' : ${dashboard>riskLevel} === 'High' ? 'Warning' : ${dashboard>riskLevel} === 'Medium' ? 'Information' : 'Success' }" />
                        </HBox>
                    </HBox>
                    <Text text="{dashboard>description}" wrapping="true" class="sapUiTinyMarginBottom" />
                    <HBox alignItems="Center">
                        <Button text="Investigate" press=".onInvestigateRisk" class="sapUiTinyMarginEnd" />
                        <Label text="{= ${dashboard>poCount} + ' POs' }"
                               visible="{= !!${dashboard>poCount} }"
                               tooltip="{dashboard>poTooltip}"
                               class="sapUiTinyMarginEnd" />
                        <Label text="&#xB7;" visible="{= !!${dashboard>poCount} }" class="sapUiTinyMarginEnd" />
                        <Label text="{= ${dashboard>materialCount} + ' Materials' }"
                               visible="{= !!${dashboard>poCount} }"
                               tooltip="{dashboard>materialTooltip}"
                               class="sapUiTinyMarginEnd" />
                        <Label text="&#xB7;" visible="{= !!${dashboard>poCount} }" class="sapUiTinyMarginEnd" />
                        <Label text="{= ${dashboard>plantCount} + ' Plants' }"
                               visible="{= !!${dashboard>poCount} }"
                               tooltip="{dashboard>plantTooltip}"
                               class="sapUiTinyMarginEnd" />
                        <Label text="&#xB7;" visible="{= !!${dashboard>poCount} }" class="sapUiTinyMarginEnd" />
                        <Label text="{= ${dashboard>supplierCount} + ' Suppliers' }"
                               visible="{= !!${dashboard>poCount} }"
                               tooltip="{dashboard>supplierTooltip}" />
                    </HBox>
                </VBox>
            </CustomListItem>
        </List>

        <Toolbar design="Transparent">
            <ToolbarSpacer />
            <Link text="{i18n>ctViewAllDisruptions}" press=".onViewAllDisruptions" />
            <core:Icon src="sap-icon://slim-arrow-right" />
        </Toolbar>
    </Panel>
</core:FragmentDefinition>
