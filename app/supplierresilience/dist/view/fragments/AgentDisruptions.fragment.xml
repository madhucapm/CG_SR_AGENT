<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Agent Disruptions — per-agent execution. sap_horizon default theme. -->
    <VBox width="100%">

        <Toolbar design="Transparent">
            <Title text="Disruptions" level="H2" />
        </Toolbar>
        <Text text="Agent execution and disruption analysis for the selected case." class="sapUiSmallMarginBottom" />

        <!-- CASE ID SELECTOR -->
        <Toolbar design="Solid" class="sapUiSmallMarginBottom">
            <Label text="CASE ID" />
            <Select
                id="agentDisruptionsCaseSelect"
                selectedKey="{agentDisruptions>/selectedCaseId}"
                change=".onAgentDisruptionsCaseChange"
                forceSelection="false"
                autoAdjustWidth="true"
                items="{caseHierarchy>/availableCases}">
                <core:Item key="{caseHierarchy>caseId}"
                           text="{caseHierarchy>caseId} \u2014 {caseHierarchy>eventTitle}" />
            </Select>
            <Text text="No cases available. Investigate an event in News Feed to create a case."
                  visible="{= ${caseHierarchy>/availableCases}.length === 0 }" />
        </Toolbar>

        <!-- EMPTY STATE -->
        <VBox visible="{= !${agentDisruptions>/caseData} }"
              alignItems="Center" justifyContent="Center" class="sapUiLargeMarginTopBottom">
            <core:Icon src="sap-icon://folder-blank" size="3rem" color="Default" />
            <Text text="No active case selected." class="sapUiSmallMarginTop" />
            <Text text="Select a case above or run an agent from the Case Dashboard to begin." />
        </VBox>

        <!-- CASE DETAILS + AGENT EXECUTION -->
        <VBox visible="{= !!${agentDisruptions>/caseData} }" width="100%">

            <!-- CASE DETAILS HEADER -->
            <Panel class="sapUiSmallMarginBottom">
                <headerToolbar>
                    <Toolbar>
                        <Title text="#{agentDisruptions>/caseData/caseId}" level="H3" />
                    </Toolbar>
                </headerToolbar>
                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <Label text="EVENT" class="sapUiSmallMarginEnd" />
                    <Text text="{agentDisruptions>/caseData/eventTitle}" />
                </HBox>
                <HBox alignItems="Center">
                    <ObjectStatus text="{agentDisruptions>/caseData/severity}"
                          state="{= ${agentDisruptions>/caseData/severity} === &apos;CRITICAL&apos; ? &apos;Error&apos; : &apos;Warning&apos; }" />
                </HBox>
            </Panel>

            <!-- CASE KPI ROW -->
            <HBox width="100%" class="sapUiSmallMarginBottom">
                <GenericTile header="SUPPLIER" frameType="OneByOne" class="sapUiTinyMarginEnd">
                    <TileContent><NumericContent value="{agentDisruptions>/caseData/supplierCount}" /></TileContent>
                </GenericTile>
                <GenericTile header="PO" frameType="OneByOne" class="sapUiTinyMarginEnd">
                    <TileContent><NumericContent value="{agentDisruptions>/caseData/poCount}" /></TileContent>
                </GenericTile>
                <GenericTile header="PLANT" frameType="OneByOne" class="sapUiTinyMarginEnd">
                    <TileContent><NumericContent value="{agentDisruptions>/caseData/plantCount}" /></TileContent>
                </GenericTile>
                <GenericTile header="MATERIALS" frameType="OneByOne">
                    <TileContent><NumericContent value="{agentDisruptions>/caseData/materialCount}" /></TileContent>
                </GenericTile>
            </HBox>

            <!-- AGENT CARDS -->
            <Title text="AGENT EXECUTION" level="H4" class="sapUiSmallMarginBottom" />
            <HBox width="100%" wrap="Wrap">

                <!-- SURVIVAL PLANNER -->
                <Panel class="sapUiTinyMarginEnd sapUiSmallMarginBottom" width="calc(50% - 0.5rem)">
                    <headerToolbar><Toolbar><core:Icon src="sap-icon://inventory" class="sapUiSmallMarginEnd" /><Title text="Survival Planner" level="H5" /></Toolbar></headerToolbar>
                    <Text text="Calculates stock coverage, time-to-survive, recovery gap" class="sapUiSmallMarginBottom" />
                    <Button text="{= ${agentDisruptions>/agents/survivalPlanner/busy} ? &apos;Running...&apos; : &apos;Run&apos; }" press=".onRunDisruptionSurvivalPlanner" type="Emphasized" enabled="{= !${agentDisruptions>/agents/survivalPlanner/busy} }" class="sapUiSmallMarginBottom" />
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom"><Label text="Status:" class="sapUiSmallMarginEnd" /><ObjectStatus text="{agentDisruptions>/agents/survivalPlanner/statusText}" state="{= ${agentDisruptions>/agents/survivalPlanner/status} === &apos;completed&apos; ? &apos;Success&apos; : ${agentDisruptions>/agents/survivalPlanner/status} === &apos;failed&apos; ? &apos;Error&apos; : ${agentDisruptions>/agents/survivalPlanner/status} === &apos;running&apos; ? &apos;Information&apos; : &apos;None&apos; }" /></HBox>
                    <VBox visible="{= ${agentDisruptions>/agents/survivalPlanner/status} === &apos;completed&apos; }" class="sapUiSmallMarginTop"><Label text="Response:" /><core:HTML content="{agentDisruptions>/agents/survivalPlanner/formattedResult}" /></VBox>
                    <MessageStrip visible="{= ${agentDisruptions>/agents/survivalPlanner/status} === &apos;failed&apos; }" text="{agentDisruptions>/agents/survivalPlanner/error}" type="Error" showIcon="true" class="sapUiSmallMarginTop" />
                </Panel>

                <!-- BUYER -->
                <Panel class="sapUiTinyMarginEnd sapUiSmallMarginBottom" width="calc(50% - 0.5rem)">
                    <headerToolbar><Toolbar><core:Icon src="sap-icon://cart" class="sapUiSmallMarginEnd" /><Title text="Buyer" level="H5" /></Toolbar></headerToolbar>
                    <Text text="PO creation, stock transfers and procurement execution" class="sapUiSmallMarginBottom" />
                    <Button text="{= ${agentDisruptions>/agents/buyer/busy} ? &apos;Running...&apos; : &apos;Run&apos; }" press=".onRunDisruptionBuyer" type="Emphasized" enabled="{= !${agentDisruptions>/agents/buyer/busy} }" class="sapUiSmallMarginBottom" />
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom"><Label text="Status:" class="sapUiSmallMarginEnd" /><ObjectStatus text="{agentDisruptions>/agents/buyer/statusText}" state="{= ${agentDisruptions>/agents/buyer/status} === &apos;completed&apos; ? &apos;Success&apos; : ${agentDisruptions>/agents/buyer/status} === &apos;failed&apos; ? &apos;Error&apos; : ${agentDisruptions>/agents/buyer/status} === &apos;running&apos; ? &apos;Information&apos; : &apos;None&apos; }" /></HBox>
                    <VBox visible="{= ${agentDisruptions>/agents/buyer/status} === &apos;completed&apos; }" class="sapUiSmallMarginTop"><Label text="Response:" /><core:HTML content="{agentDisruptions>/agents/buyer/formattedResult}" /></VBox>
                    <MessageStrip visible="{= ${agentDisruptions>/agents/buyer/status} === &apos;failed&apos; }" text="{agentDisruptions>/agents/buyer/error}" type="Error" showIcon="true" class="sapUiSmallMarginTop" />
                </Panel>

                <!-- RECOMMENDATION -->
                <Panel class="sapUiSmallMarginBottom" width="calc(50% - 0.5rem)">
                    <headerToolbar><Toolbar><core:Icon src="sap-icon://lightbulb" class="sapUiSmallMarginEnd" /><Title text="Recommendation" level="H5" /></Toolbar></headerToolbar>
                    <Text text="Scenario ranking and mitigation recommendations and substutions" class="sapUiSmallMarginBottom" />
                    <Button text="{= ${agentDisruptions>/agents/recommendation/busy} ? &apos;Running...&apos; : &apos;Run&apos; }" press=".onRunDisruptionRecommendation" type="Emphasized" enabled="{= !${agentDisruptions>/agents/recommendation/busy} }" class="sapUiSmallMarginBottom" />
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom"><Label text="Status:" class="sapUiSmallMarginEnd" /><ObjectStatus text="{agentDisruptions>/agents/recommendation/statusText}" state="{= ${agentDisruptions>/agents/recommendation/status} === &apos;completed&apos; ? &apos;Success&apos; : ${agentDisruptions>/agents/recommendation/status} === &apos;failed&apos; ? &apos;Error&apos; : ${agentDisruptions>/agents/recommendation/status} === &apos;running&apos; ? &apos;Information&apos; : &apos;None&apos; }" /></HBox>
                    <VBox visible="{= ${agentDisruptions>/agents/recommendation/status} === &apos;completed&apos; }" class="sapUiSmallMarginTop"><Label text="Response:" /><core:HTML content="{agentDisruptions>/agents/recommendation/formattedResult}" /></VBox>
                    <MessageStrip visible="{= ${agentDisruptions>/agents/recommendation/status} === &apos;failed&apos; }" text="{agentDisruptions>/agents/recommendation/error}" type="Error" showIcon="true" class="sapUiSmallMarginTop" />
                </Panel>

            </HBox>
        </VBox>
    </VBox>
</core:FragmentDefinition>
