<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Recommendations & Approval — Static prototype (MVP1). sap_horizon default theme. -->
    <VBox width="100%">

        <Toolbar design="Transparent">
            <Title text="Recommendations &amp; Approval" level="H2" />
        </Toolbar>
        <Text text="Substitution Agent recommendations with scenario comparison. Approve or reject for execution." class="sapUiSmallMarginBottom" />

        <Toolbar design="Solid" class="sapUiSmallMarginBottom">
            <Label text="CASE ID" />
            <Text text="{= ${dashboard>/selectedCaseId} ? ${dashboard>/selectedCaseId} : '\u2014 none active \u2014' }" />
            <Text text="Preview and confirm an event in News Feed to create a case."
                  visible="{= !${dashboard>/selectedCaseId} }" />
        </Toolbar>

        <!-- SCENARIO COMPARISON -->
        <Panel class="sapUiSmallMarginBottom">
            <headerToolbar>
                <Toolbar>
                    <Title text="SCENARIO COMPARISON (LITE)" level="H4" />
                    <ToolbarSpacer />
                    <Text text="OPEN: BUSINESS KPI + COST DISPLAY" />
                </Toolbar>
            </headerToolbar>

            <HBox class="sapUiSmallMarginBottom">
                <Panel class="sapUiTinyMarginEnd" width="33%">
                    <headerToolbar><Toolbar><ObjectStatus text="RECOMMENDED" state="Success" /><ToolbarSpacer /><Title text="Alt Supplier + Stock Transfer" level="H5" /></Toolbar></headerToolbar>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Cost Impact" class="sapUiSmallMarginEnd" width="6rem" /><Text text="+8%" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Lead Time" class="sapUiSmallMarginEnd" width="6rem" /><Text text="12 days" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Risk Level" class="sapUiSmallMarginEnd" width="6rem" /><ObjectStatus text="Low" state="Success" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Coverage" class="sapUiSmallMarginEnd" width="6rem" /><Text text="100%" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="OTIF Recovery" class="sapUiSmallMarginEnd" width="6rem" /><Text text="-8% \u2192 -1%" /></HBox>
                    <ObjectStatus text="\u2713 AI Recommended" state="Success" />
                </Panel>
                <Panel class="sapUiTinyMarginEnd" width="33%">
                    <headerToolbar><Toolbar><Text text="OPTION B" /><ToolbarSpacer /><Title text="Alt Material (Aluminium 3003)" level="H5" /></Toolbar></headerToolbar>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Cost Impact" class="sapUiSmallMarginEnd" width="6rem" /><Text text="+12%" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Lead Time" class="sapUiSmallMarginEnd" width="6rem" /><Text text="18 days" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Risk Level" class="sapUiSmallMarginEnd" width="6rem" /><ObjectStatus text="Medium" state="Warning" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Coverage" class="sapUiSmallMarginEnd" width="6rem" /><Text text="85%" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="OTIF Recovery" class="sapUiSmallMarginEnd" width="6rem" /><Text text="-8% \u2192 -3%" /></HBox>
                </Panel>
                <Panel width="33%">
                    <headerToolbar><Toolbar><Text text="OPTION C" /><ToolbarSpacer /><Title text="Wait for Recovery" level="H5" /></Toolbar></headerToolbar>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Cost Impact" class="sapUiSmallMarginEnd" width="6rem" /><Text text="$0" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Lead Time" class="sapUiSmallMarginEnd" width="6rem" /><Text text="45+ days" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Risk Level" class="sapUiSmallMarginEnd" width="6rem" /><ObjectStatus text="High" state="Error" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="Coverage" class="sapUiSmallMarginEnd" width="6rem" /><Text text="0%" /></HBox>
                    <HBox class="sapUiTinyMarginBottom"><Label text="OTIF Recovery" class="sapUiSmallMarginEnd" width="6rem" /><Text text="-8% maintained" /></HBox>
                </Panel>
            </HBox>
        </Panel>

        <!-- RECOMMENDATION CARDS -->
        <Panel class="sapUiSmallMarginBottom">
            <headerToolbar><Toolbar><Title text="RECOMMENDATIONS" level="H4" /></Toolbar></headerToolbar>

            <!-- Recommendation 1 -->
            <Panel class="sapUiSmallMarginBottom">
                <headerToolbar>
                    <Toolbar>
                        <Title text="Switch to Indorama Ventures (qualified)" level="H5" />
                        <ToolbarSpacer />
                        <ObjectStatus text="Alt Supplier" state="Information" />
                    </Toolbar>
                </headerToolbar>
                <HBox class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMarginEnd"><Label text="Supplier" /><Text text="Indorama Ventures" /></VBox>
                    <VBox class="sapUiSmallMarginEnd"><Label text="Material" /><Text text="PET Resin" /></VBox>
                    <VBox><Label text="Qty" /><Text text="200 MT" /></VBox>
                </HBox>
                <HBox class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMarginEnd"><Label text="Projected OTIF Impact" /><Text text="-8% \u2192 -2%" /></VBox>
                    <VBox><Label text="Cost / KPI Impact Avoided" /><ObjectStatus text="$1.2M avoided" state="Success" /></VBox>
                </HBox>
                <Input placeholder="Comment (optional)..." class="sapUiSmallMarginBottom" />
                <HBox>
                    <Button text="Approve" press=".onRecommendationAction" type="Accept" class="sapUiTinyMarginEnd" />
                    <Button text="Reject" press=".onRecommendationAction" type="Reject" />
                </HBox>
            </Panel>

            <!-- Recommendation 2 -->
            <Panel class="sapUiSmallMarginBottom">
                <headerToolbar>
                    <Toolbar>
                        <Title text="Transfer from Pune Safety Stock" level="H5" />
                        <ToolbarSpacer />
                        <ObjectStatus text="Stock Transfer" state="Information" />
                    </Toolbar>
                </headerToolbar>
                <HBox class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMarginEnd"><Label text="Source" /><Text text="Pune Plant" /></VBox>
                    <VBox class="sapUiSmallMarginEnd"><Label text="Dest" /><Text text="Mumbai Plant" /></VBox>
                    <VBox><Label text="Qty" /><Text text="80 MT" /></VBox>
                </HBox>
                <HBox class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMarginEnd"><Label text="Projected OTIF Impact" /><Text text="-8% \u2192 -4%" /></VBox>
                    <VBox><Label text="Cost / KPI Impact Avoided" /><ObjectStatus text="$0.5M avoided" state="Success" /></VBox>
                </HBox>
                <Input placeholder="Comment (optional)..." class="sapUiSmallMarginBottom" />
                <HBox>
                    <Button text="Approve" press=".onRecommendationAction" type="Accept" class="sapUiTinyMarginEnd" />
                    <Button text="Reject" press=".onRecommendationAction" type="Reject" />
                </HBox>
            </Panel>

            <!-- Recommendation 3 -->
            <Panel>
                <headerToolbar>
                    <Toolbar>
                        <Title text="Use Al Alloy 3003 (qualified)" level="H5" />
                        <ToolbarSpacer />
                        <ObjectStatus text="Alt Material" state="Information" />
                    </Toolbar>
                </headerToolbar>
                <HBox class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMarginEnd"><Label text="Material" /><Text text="Al Alloy 3003" /></VBox>
                    <VBox class="sapUiSmallMarginEnd"><Label text="Supplier" /><Text text="ABC alt line" /></VBox>
                    <VBox><Label text="Compliance" /><ObjectStatus text="Approved" state="Success" /></VBox>
                </HBox>
                <HBox class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMarginEnd"><Label text="Projected OTIF Impact" /><Text text="-8% \u2192 -3%" /></VBox>
                    <VBox><Label text="Cost / KPI Impact Avoided" /><ObjectStatus text="$0.7M avoided" state="Success" /></VBox>
                </HBox>
                <Input placeholder="Comment (optional)..." class="sapUiSmallMarginBottom" />
                <HBox>
                    <Button text="Approve" press=".onRecommendationAction" type="Accept" class="sapUiTinyMarginEnd" />
                    <Button text="Reject" press=".onRecommendationAction" type="Reject" />
                </HBox>
            </Panel>
        </Panel>

    </VBox>
</core:FragmentDefinition>
