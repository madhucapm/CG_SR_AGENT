<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Execution Tracking — Real S/4HANA PO/STO creation results. sap_horizon. -->
    <VBox width="100%">

        <Toolbar design="Transparent">
            <Title text="Execution Tracking" level="H2" />
        </Toolbar>
        <Text text="Buyer Agent execution results — real Purchase Orders and Stock Transport Orders created in S/4HANA." class="sapUiSmallMarginBottom" />

        <!-- Case selector -->
        <Toolbar design="Solid" class="sapUiSmallMarginBottom">
            <Label text="CASE ID" />
            <Select
                selectedKey="{dashboard>/selectedCaseId}"
                change=".onCaseDropdownChange"
                forceSelection="false"
                autoAdjustWidth="true"
                items="{caseHierarchy>/availableCases}">
                <core:Item key="{caseHierarchy>caseId}"
                           text="{= ${caseHierarchy>caseId} + (${caseHierarchy>eventTitle} ? ' — ' + ${caseHierarchy>eventTitle} : '')}" />
            </Select>
            <Text text="No cases available. Investigate an event in News Feed to create a case."
                  visible="{= ${caseHierarchy>/availableCases}.length === 0 }" />
        </Toolbar>

        <!-- KPI Tiles -->
        <HBox width="100%" class="sapUiSmallMarginBottom">
            <GenericTile header="STOs CREATED" subheader="Stock Transport Orders" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent>
                    <NumericContent value="{execution>/stoCreatedCount}" valueColor="Good" />
                </TileContent>
            </GenericTile>
            <GenericTile header="POs CREATED" subheader="Purchase Orders" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent>
                    <NumericContent value="{execution>/poCreatedCount}" valueColor="Good" />
                </TileContent>
            </GenericTile>
            <GenericTile header="FAILED" subheader="Errors" frameType="OneByOne" class="sapUiTinyMarginEnd">
                <TileContent>
                    <NumericContent value="{execution>/failedCount}" valueColor="Error" />
                </TileContent>
            </GenericTile>
            <GenericTile header="PROCESSING" subheader="In progress" frameType="OneByOne">
                <TileContent>
                    <NumericContent value="{execution>/pendingCount}" valueColor="Neutral" />
                </TileContent>
            </GenericTile>
        </HBox>

        <!-- Empty state -->
        <MessageStrip
            text="No execution items yet. Approve a recommendation from the Recommendations tab to create a PO or STO in S/4HANA."
            type="Information"
            showIcon="true"
            class="sapUiSmallMarginBottom"
            visible="{= ${execution>/executionItems}.length === 0 }" />

        <!-- Execution Items Table -->
        <Panel class="sapUiSmallMarginBottom"
               visible="{= ${execution>/executionItems}.length > 0 }">
            <headerToolbar>
                <Toolbar>
                    <Title text="EXECUTION ACTIONS" level="H4" />
                    <ToolbarSpacer />
                    <Text text="{= ${execution>/executionItems}.length } action(s) total" />
                </Toolbar>
            </headerToolbar>
            <Table items="{execution>/executionItems}" showSeparators="Inner" fixedLayout="false">
                <columns>
                    <Column width="8%"><Text text="ACTION ID" /></Column>
                    <Column width="9%"><Text text="ORDER TYPE" /></Column>
                    <Column width="12%"><Text text="TYPE" /></Column>
                    <Column width="13%"><Text text="MATERIAL" /></Column>
                    <Column width="13%"><Text text="PLANT / SOURCE" /></Column>
                    <Column width="12%"><Text text="PO/STO NUMBER" /></Column>
                    <Column width="12%"><Text text="STATUS" /></Column>
                    <Column width="13%"><Text text="STRATEGY" /></Column>
                    <Column width="8%"><Text text="TIME" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{execution>id}" />
                            <ObjectStatus
                                text="{execution>orderType}"
                                state="{= ${execution>orderType} === 'STO' ? 'Success' : 'Information' }"
                                icon="{= ${execution>orderType} === 'STO' ? 'sap-icon://factory' : 'sap-icon://cart-3' }" />
                            <Text text="{execution>type}" />
                            <Text text="{execution>material}" />
                            <Text text="{execution>plant}" />
                            <Link text="{execution>poNumber}"
                                  visible="{= !!${execution>poNumber} }"
                                  press=".onViewMonitoring" />
                            <ObjectStatus
                                text="{execution>status}"
                                state="{= ${execution>status} === 'Confirmed' ? 'Success' : ${execution>status} === 'Failed' ? 'Error' : 'Warning' }" />
                            <Text text="{execution>strategy}" />
                            <Text text="{execution>time}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>

        <!-- Error details (if any failed) -->
        <Panel headerText="ERROR DETAILS" expandable="true" expanded="false"
               visible="{= ${execution>/failedCount} > 0 }">
            <List items="{
                path: 'execution>/executionItems',
                filters: [{ path: 'status', operator: 'EQ', value1: 'Failed' }]
            }">
                <StandardListItem
                    title="{execution>id} — {execution>material}"
                    description="{execution>error}"
                    icon="sap-icon://message-error"
                    type="Inactive" />
            </List>
        </Panel>

        <!-- Progress -->
        <Panel visible="{= ${execution>/totalCount} > 0 }">
            <headerToolbar><Toolbar><Title text="PROGRESS" level="H4" /></Toolbar></headerToolbar>
            <HBox class="sapUiSmallMarginBottom">
                <VBox width="50%" class="sapUiSmallMarginEnd">
                    <Label text="Execution Progress" class="sapUiSmallMarginBottom" />
                    <ProgressIndicator
                        percentValue="{= ${execution>/totalCount} > 0 ? Math.round(((${execution>/stoCreatedCount} + ${execution>/poCreatedCount}) / ${execution>/totalCount}) * 100) : 0 }"
                        displayValue="{= (${execution>/stoCreatedCount} + ${execution>/poCreatedCount}) + ' of ' + ${execution>/totalCount} + ' confirmed' }"
                        state="{= (${execution>/stoCreatedCount} + ${execution>/poCreatedCount}) === ${execution>/totalCount} ? 'Success' : 'Information' }" />
                </VBox>
                <VBox width="50%">
                    <Label text="STO vs PO Breakdown" class="sapUiSmallMarginBottom" />
                    <ProgressIndicator
                        percentValue="{= (${execution>/stoCreatedCount} + ${execution>/poCreatedCount}) > 0 ? Math.round((${execution>/stoCreatedCount} / (${execution>/stoCreatedCount} + ${execution>/poCreatedCount})) * 100) : 0 }"
                        displayValue="{= ${execution>/stoCreatedCount} + ' STO(s) / ' + ${execution>/poCreatedCount} + ' PO(s)' }"
                        state="Information" />
                </VBox>
            </HBox>
        </Panel>

    </VBox>
</core:FragmentDefinition>