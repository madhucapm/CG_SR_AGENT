<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <VBox width="100%"
          busy="{caseHierarchy>/busy}" busyIndicatorDelay="0">

        <Toolbar design="Transparent">
            <Title text="Case Dashboard" level="H2" />
        </Toolbar>
        <Text text="Hierarchical view: Supplier → Purchase Order → Plant → SKU. Plant view shows only impacted PO items." class="sapUiSmallMarginBottom" />

        <!-- Case selector dropdown -->
        <Toolbar design="Solid" class="sapUiSmallMarginBottom">
            <Label text="CASE ID" />
            <Select
                selectedKey="{dashboard>/selectedCaseId}"
                change=".onCaseDropdownChange"
                forceSelection="false"
                autoAdjustWidth="true"
                items="{caseHierarchy>/availableCases}">
                <core:Item key="{caseHierarchy>caseId}"
                           text="{caseHierarchy>caseId} — {caseHierarchy>eventTitle}" />
            </Select>
            <Text text="No cases available. Investigate an event in News Feed to create a case."
                  visible="{= ${caseHierarchy>/availableCases}.length === 0 }" />
        </Toolbar>

        <VBox visible="{= !${caseHierarchy>/caseData} &amp;&amp; !${caseHierarchy>/busy} }"
              alignItems="Center" justifyContent="Center" class="sapUiLargeMarginTopBottom">
            <core:Icon src="sap-icon://folder-blank" size="3rem" color="Default" />
            <Text text="No active case selected." class="sapUiSmallMarginTop" />
            <Text text="Investigate and confirm a disruption event in the News Feed to create a case." />
        </VBox>

        <VBox visible="{= !!${caseHierarchy>/caseData} }" width="100%">

            <!-- CASE HEADER -->
            <Panel class="sapUiSmallMarginBottom">
                <headerToolbar>
                    <Toolbar>
                        <Title text="#{caseHierarchy>/caseData/caseId}" level="H3" />
                        <ToolbarSpacer />
                        <Button text="View Monitoring →" press=".onViewMonitoring" type="Transparent" />
                    </Toolbar>
                </headerToolbar>
                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <Label text="EVENT" class="sapUiSmallMarginEnd" />
                    <Text text="{caseHierarchy>/caseData/eventTitle}" />
                </HBox>
                <HBox alignItems="Center">
                    <ObjectStatus text="{caseHierarchy>/caseData/severity}"
                                  state="{= ${caseHierarchy>/caseData/severity} === 'CRITICAL' ? 'Error' : 'Warning' }" />
                </HBox>
            </Panel>

            <!-- KPI CARDS -->
            <HBox width="100%" class="sapUiSmallMarginBottom">
                <GenericTile header="SUPPLIERS IMPACTED" subheader="Primary risk driver" frameType="OneByOne" class="sapUiTinyMarginEnd">
                    <TileContent><NumericContent value="{caseHierarchy>/caseData/supplierCount}" valueColor="Error" /></TileContent>
                </GenericTile>
                <GenericTile header="POs AT RISK" subheader="Across active events" frameType="OneByOne" class="sapUiTinyMarginEnd">
                    <TileContent><NumericContent value="{caseHierarchy>/caseData/poCount}" valueColor="Critical" /></TileContent>
                </GenericTile>
                <GenericTile header="PLANTS AFFECTED" subheader="Multi-region" frameType="OneByOne" class="sapUiTinyMarginEnd">
                    <TileContent><NumericContent value="{caseHierarchy>/caseData/plantCount}" valueColor="Neutral" /></TileContent>
                </GenericTile>
                <GenericTile header="SKUs AFFECTED" subheader="Beverage packaging" frameType="OneByOne">
                    <TileContent><NumericContent value="{caseHierarchy>/caseData/skuCount}" valueColor="Good" /></TileContent>
                </GenericTile>
            </HBox>

            <!-- MAIN BODY: Hierarchy + Agent Execution -->
            <HBox width="100%">

                <!-- Left: CASE HIERARCHY (ALL cases from HANA) -->
                <Panel width="100%" expandable="false"
                       busy="{caseHierarchy>/allCasesBusy}" busyIndicatorDelay="0">
                    <headerToolbar>
                        <Toolbar><Title text="CASE HIERARCHY" level="H4" /></Toolbar>
                    </headerToolbar>

                    <List items="{caseHierarchy>/allCasesTree}"
                          showSeparators="Inner"
                          noDataText="No cases found.">
                        <CustomListItem>
                            <VBox width="100%" class="sapUiTinyMarginTopBottom">
                                <!-- CASE row -->
                                <HBox alignItems="Center">
                                    <Button icon="{= ${caseHierarchy>_expanded} ? 'sap-icon://navigation-down-arrow' : 'sap-icon://navigation-right-arrow' }"
                                            press=".onHierToggle" type="Transparent" />
                                    <core:Icon src="sap-icon://folder-full" class="sapUiSmallMarginEnd" />
                                    <Text text="{caseHierarchy>caseId}" class="sapUiSmallMarginEnd sapMTextBold" />
                                    <Text text="{caseHierarchy>eventTitle}" class="sapUiSmallMarginEnd" wrapping="true" />
                                    <ObjectStatus text="{caseHierarchy>severity}"
                                          state="{= ${caseHierarchy>severity} === 'CRITICAL' ? 'Error' : ${caseHierarchy>severity} === 'HIGH' ? 'Warning' : 'None' }" />
                                </HBox>
                                <!-- SUPPLIER level -->
                                <VBox visible="{caseHierarchy>_expanded}" class="sapUiSmallMarginStart">
                                    <List items="{ path: 'caseHierarchy>suppliers', templateShareable: false }"
                                          showSeparators="None">
                                        <CustomListItem>
                                            <VBox>
                                                <HBox alignItems="Center">
                                                    <Button icon="{= ${caseHierarchy>_expanded} ? 'sap-icon://navigation-down-arrow' : 'sap-icon://navigation-right-arrow' }"
                                                            press=".onHierToggle" type="Transparent" />
                                                    <core:Icon src="sap-icon://supplier" class="sapUiSmallMarginEnd" />
                                                    <Text text="{caseHierarchy>name}" class="sapUiSmallMarginEnd sapMTextBold" />
                                                    <ObjectStatus text="{caseHierarchy>severity}" state="{= ${caseHierarchy>severity} === 'CRITICAL' ? 'Error' : 'Warning' }" />
                                                </HBox>
                                                <!-- PO level -->
                                                <VBox visible="{caseHierarchy>_expanded}" class="sapUiSmallMarginStart">
                                                    <List items="{ path: 'caseHierarchy>purchaseOrders', templateShareable: false }" showSeparators="None">
                                                        <CustomListItem>
                                                            <VBox>
                                                                <HBox alignItems="Center">
                                                                    <Button icon="{= ${caseHierarchy>_expanded} ? 'sap-icon://navigation-down-arrow' : 'sap-icon://navigation-right-arrow' }"
                                                                            press=".onHierToggle" type="Transparent" />
                                                                    <core:Icon src="sap-icon://shipping-status" class="sapUiSmallMarginEnd" />
                                                                    <Text text="{caseHierarchy>poNumber}" class="sapMTextBold" />
                                                                </HBox>
                                                                <!-- PLANT level -->
                                                                <VBox visible="{caseHierarchy>_expanded}" class="sapUiSmallMarginStart">
                                                                    <List items="{ path: 'caseHierarchy>plants', templateShareable: false }" showSeparators="None">
                                                                        <CustomListItem>
                                                                            <VBox>
                                                                                <HBox alignItems="Center">
                                                                                    <Button icon="{= ${caseHierarchy>_expanded} ? 'sap-icon://navigation-down-arrow' : 'sap-icon://navigation-right-arrow' }"
                                                                                            press=".onHierToggle" type="Transparent" />
                                                                                    <core:Icon src="sap-icon://factory" class="sapUiSmallMarginEnd" />
                                                                                    <Text text="{caseHierarchy>plant}" />
                                                                                </HBox>
                                                                                <!-- MATERIAL level (leaf — no toggle) -->
                                                                                <VBox visible="{caseHierarchy>_expanded}" class="sapUiSmallMarginStart">
                                                                                    <List items="{ path: 'caseHierarchy>materials', templateShareable: false }" showSeparators="None">
                                                                                        <CustomListItem>
                                                                                            <HBox alignItems="Center">
                                                                                                <core:Icon src="sap-icon://product" class="sapUiSmallMarginEnd" />
                                                                                                <Text text="{= ${caseHierarchy>sku} || ${caseHierarchy>material} || '—' }" />
                                                                                            </HBox>
                                                                                        </CustomListItem>
                                                                                    </List>
                                                                                </VBox>
                                                                            </VBox>
                                                                        </CustomListItem>
                                                                    </List>
                                                                </VBox>
                                                            </VBox>
                                                        </CustomListItem>
                                                    </List>
                                                </VBox>
                                            </VBox>
                                        </CustomListItem>
                                    </List>
                                </VBox>
                            </VBox>
                        </CustomListItem>
                    </List>
                </Panel>

                <!-- Right: AGENT EXECUTION + CASE SUMMARY -->
                <Panel class="sapUiSmallMarginStart" width="20rem">
                    <headerToolbar>
                        <Toolbar><Title text="AGENT EXECUTION" level="H4" /></Toolbar>
                    </headerToolbar>
                    <VBox class="sapUiSmallMarginBottom">
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                            <Text text="Early Warning" class="sapUiSmallMarginEnd" />
                            <Button text="Run" press=".onRunEarlyWarningAgent" type="Transparent" enabled="true" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                            <Text text="Coordinator" class="sapUiSmallMarginEnd" />
                            <Button text="Run" press=".onRunCoordinatorAgent" type="Transparent" enabled="true" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                            <Text text="Survival Planner" class="sapUiSmallMarginEnd" />
                            <Button text="Run" press=".onRunSurvivalPlannerAgent" type="Transparent" enabled="true" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                            <Text text="Substitution" class="sapUiSmallMarginEnd" />
                            <Button text="Run" press=".onRunSubstitutionAgent" type="Transparent" enabled="true" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon src="sap-icon://circle-task-2" class="sapUiSmallMarginEnd" />
                            <Text text="Buyer" class="sapUiSmallMarginEnd" />
                            <Button text="Run" press=".onRunBuyerAgent" type="Transparent" enabled="true" />
                        </HBox>
                    </VBox>
                    <Button text="Run All Agents" press=".onRunAllAgents" type="Emphasized" width="100%" enabled="true" />

                    <Toolbar design="Transparent" class="sapUiSmallMarginTop"><ToolbarSpacer /></Toolbar>

                    <!-- CASE SUMMARY -->
                    <Title text="CASE SUMMARY" level="H4" class="sapUiSmallMarginBottom" />
                    <VBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Case ID" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/caseId}" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Event" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/eventTitle}" wrapping="true" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Risk Score" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/riskScore}" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Severity" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/severity}" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Impact" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/estimatedImpact}" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Region" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/region}" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Suppliers" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/supplierCount}" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="POs" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/poCount}" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Plants" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/plantCount}" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="SKUs" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/skuCount}" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Status" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/status}" /></HBox>
                        <HBox class="sapUiTinyMarginBottom"><Label text="Created" class="sapUiSmallMarginEnd" width="5rem" /><Text text="{caseHierarchy>/caseData/createdAt}" /></HBox>
                    </VBox>
                </Panel>
            </HBox>

        </VBox>
    </VBox>
</core:FragmentDefinition>
