<mvc:View
    controllerName="supplierresilience.controller.View1"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">
    <Page showHeader="false" enableScrolling="false">
        <content>
            <HBox class="towerShell">
                <VBox class="sidebarWrap">
                    <!-- ── Sidebar branding block ── -->
                    <HBox class="sidebarBrand">
                        <FlexBox class="brandAvatar" alignItems="Center" justifyContent="Center">
                            <Text text="SC" class="brandAvatarText" />
                        </FlexBox>
                        <VBox class="brandTextWrap">
                            <Text text="Resilience Copilot" class="brandPrimaryTitle" />
                            <Text text="Supply Chain MVP1" class="brandSubtitle" />
                        </VBox>
                    </HBox>

                    <tnt:SideNavigation expanded="true" itemSelect="onNavSelect" class="towerNav">
                        <tnt:layoutData>
                            <FlexItemData growFactor="1" />
                        </tnt:layoutData>
                        <tnt:NavigationList>
                            <!-- MONITOR group -->
                        <tnt:NavigationListItem text="MONITOR" enabled="false" class="navSectionLabel">
                        </tnt:NavigationListItem> 
                      

                            <tnt:NavigationListItem key="control" text="News Feed" icon="sap-icon://home" />
                            <tnt:NavigationListItem key="caseDashboard" text="Case Dashboard" icon="sap-icon://batch-payments" /> 
           
                       
                        <!-- ASSESS group -->
                        <tnt:NavigationListItem text="ASSESS" enabled="false" class="navSectionLabel">
                        </tnt:NavigationListItem>
                            <tnt:NavigationListItem key="riskAssessment" text="Risk Assessment" icon="sap-icon://alert" />
                            <tnt:NavigationListItem key="survivalPlanning" text="Survival Planning" icon="sap-icon://activity-items" />
                        
                        <!-- ACT group -->
                        <tnt:NavigationListItem text="ACT" enabled="false" class="navSectionLabel">
                        </tnt:NavigationListItem>
                            <tnt:NavigationListItem key="approvals" text="Recommendations" icon="sap-icon://approvals" />
                            <tnt:NavigationListItem key="planning" text="Execution" icon="sap-icon://process" />
                        
                        <!-- TRACK group -->
                        <tnt:NavigationListItem text="TRACK" enabled="false" class="navSectionLabel">
                        </tnt:NavigationListItem>
                            <tnt:NavigationListItem key="audit" text="Monitoring" icon="sap-icon://history" />
                        
                    </tnt:NavigationList>
                </tnt:SideNavigation>
                </VBox>
                <VBox class="workspace" width="100%">
                    <Toolbar class="topbar">
                        <Title text="SUPPLIER RESILIENCE" level="H1" class="brandTitle" />
                        <ToolbarSpacer />
                      
                    </Toolbar>
                    <ScrollContainer vertical="true" height="100%" class="mainScroll">
                        <VBox class="contentPad">

                            <!--
                                News Feed home (redesigned).
                                All previous inline markup for the News Feed
                                landing page has been removed and replaced by a
                                single composed fragment for maintainability.
                                See view/fragments/ControlTowerHome.fragment.xml
                            -->
                            <VBox id="dashboardView" visible="true" class="dashboardViewWrap">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.ControlTowerHome" type="XML" />
                            </VBox>

                            <!-- Risk Assessment view (ASSESS → Risk Assessment) -->
                            <VBox id="riskAssessmentView" visible="false" class="dashboardViewWrap">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.RiskAssessment" type="XML" />
                            </VBox>

                            <!-- Survival Planning view (ASSESS → Survival Planning) -->
                            <VBox id="survivalPlanningView" visible="false" class="dashboardViewWrap">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.SurvivalPlanning" type="XML" />
                            </VBox>

                            <!-- Case Dashboard view (Impact Case detail) -->
                            <VBox id="caseDashboardView" visible="false" class="dashboardViewWrap">
                                <core:Fragment fragmentName="supplierresilience.view.fragments.CaseDashboard" type="XML" />
                            </VBox>

                        </VBox>
                    </ScrollContainer>
                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>