<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Recommendations and Approval — Data-driven from Recommendation Agent. sap_horizon default theme. -->
    <VBox width="100%"
          busy="{recommendationResult>/busy}" busyIndicatorDelay="0">

        <Toolbar design="Transparent">
            <Title text="Recommendations &amp; Approval" level="H2" />
        </Toolbar>
        <Text text="Scenario &amp; Recommendation Agent output — ranked mitigation levers with Go / No-Go scenarios." class="sapUiSmallMarginBottom" />

        <Toolbar design="Solid" class="sapUiSmallMarginBottom">
            <Label text="CASE ID" />
            <Select
                selectedKey="{dashboard>/selectedCaseId}"
                change=".onCaseDropdownChange"
                forceSelection="false"
                autoAdjustWidth="true"
                items="{caseHierarchy>/availableCases}">
                <core:Item key="{caseHierarchy>caseId}"
                           text="{caseHierarchy>caseId} — {caseHierarchy>eventTitle}" />
            </Select>
            <Text text="No cases available. Investigate an event in News Feed to create a case."
                  visible="{= ${caseHierarchy>/availableCases}.length === 0 }" />
        </Toolbar>

        <!-- EMPTY STATE -->
        <VBox visible="{= !${recommendationResult>/hasResult} &amp;&amp; !${recommendationResult>/busy} }"
              alignItems="Center" justifyContent="Center" class="sapUiLargeMarginTopBottom">
            <core:Icon src="sap-icon://lightbulb" size="3rem" color="Default" />
            <Text text="No recommendation data available." class="sapUiSmallMarginTop" />
            <Text text="Run the Recommendation agent from the Case Dashboard or Disruptions screen to generate scenario analysis." />
        </VBox>

        <!-- DATA-DRIVEN CONTENT (visible when hasResult) -->
        <VBox visible="{= !!${recommendationResult>/hasResult} }" width="100%">

            <!-- KPI ROW -->
            <HBox width="100%" class="sapUiSmallMarginBottom">
                <GenericTile header="GAP" subheader="Supply gap magnitude" frameType="OneByOne" class="sapUiTinyMarginEnd">
                    <TileContent><NumericContent value="{recommendationResult>/gapMagnitudeWeeks}" scale="wk" valueColor="Error" /></TileContent>
                </GenericTile>
                <GenericTile header="TTS" subheader="Portfolio headline" frameType="OneByOne" class="sapUiTinyMarginEnd">
                    <TileContent><NumericContent value="{recommendationResult>/portfolioHeadlineTts}" scale="wk" valueColor="Critical" /></TileContent>
                </GenericTile>
                <GenericTile header="OPTIONS" subheader="Ranked mitigation levers" frameType="OneByOne" class="sapUiTinyMarginEnd">
                    <TileContent><NumericContent value="{= ${recommendationResult>/rankedOptionList}.length }" valueColor="Neutral" /></TileContent>
                </GenericTile>
                <GenericTile header="TOP PICK" subheader="{recommendationResult>/topRecommendation/lever}" frameType="OneByOne">
                    <TileContent><NumericContent value="#1" valueColor="Good" /></TileContent>
                </GenericTile>
            </HBox>

            <!-- WEIGHT MATRIX -->
            <Panel class="sapUiSmallMarginBottom" visible="{= !!${recommendationResult>/weightMatrix} }">
                <headerToolbar>
                    <Toolbar>
                        <Title text="WEIGHT MATRIX" level="H4" />
                        <ToolbarSpacer />
                        <Text text="Agent ID: {recommendationResult>/agentId}" />
                    </Toolbar>
                </headerToolbar>
                <HBox class="sapUiSmallMarginBottom">
                    <VBox class="sapUiMediumMarginEnd"><Label text="Coverage" /><ObjectNumber number="{recommendationResult>/weightMatrix/coverage}" /></VBox>
                    <VBox class="sapUiMediumMarginEnd"><Label text="Cost" /><ObjectNumber number="{recommendationResult>/weightMatrix/cost}" /></VBox>
                    <VBox class="sapUiMediumMarginEnd"><Label text="Risk" /><ObjectNumber number="{recommendationResult>/weightMatrix/risk}" /></VBox>
                    <VBox><Label text="Verified" /><ObjectStatus text="{= ${recommendationResult>/weightMatrix/weightsSumTo1Verified} ? 'Yes' : 'No' }" state="{= ${recommendationResult>/weightMatrix/weightsSumTo1Verified} ? 'Success' : 'Error' }" /></VBox>
                </HBox>
                <Text text="{recommendationResult>/weightMatrix/weightRationale}" wrapping="true" />
            </Panel>

            <!-- RANKED OPTIONS TABLE -->
            <Panel class="sapUiSmallMarginBottom">
                <headerToolbar>
                    <Toolbar>
                        <Title text="RANKED MITIGATION OPTIONS" level="H4" />
                        <ToolbarSpacer />
                        <Text text="{= ${recommendationResult>/rankedOptionList}.length + ' option(s) ranked' }" />
                    </Toolbar>
                </headerToolbar>
                <Table items="{recommendationResult>/rankedOptionList}"
                       showSeparators="Inner" fixedLayout="false"
                       noDataText="No ranked options available.">
                    <columns>
                        <Column width="5%" hAlign="Center"><Text text="RANK" /></Column>
                        <Column width="22%"><Text text="LEVER" /></Column>
                        <Column width="10%" hAlign="Center"><Text text="COVERAGE" /></Column>
                        <Column width="10%" hAlign="Center"><Text text="COST" /></Column>
                        <Column width="8%" hAlign="Center"><Text text="RISK" /></Column>
                        <Column width="45%"><Text text="RATIONALE" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem highlight="{= ${recommendationResult>isTopRecommendation} ? 'Success' : 'None' }">
                            <cells>
                                <ObjectNumber number="{recommendationResult>rank}" />
                                <Text text="{recommendationResult>lever}" wrapping="true" />
                                <Text text="{recommendationResult>coverage}" />
                                <Text text="{recommendationResult>cost}" />
                                <ObjectStatus text="{recommendationResult>risk}" state="{recommendationResult>riskState}" />
                                <Text text="{recommendationResult>rationale}" wrapping="true" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

            <!-- SCENARIO DETAIL CARDS -->
            <Panel class="sapUiSmallMarginBottom">
                <headerToolbar>
                    <Toolbar>
                        <Title text="SCENARIO DETAILS" level="H4" />
                        <ToolbarSpacer />
                        <Text text="Go / No-Go analysis per option" />
                    </Toolbar>
                </headerToolbar>
                <List items="{recommendationResult>/rankedOptionList}" showSeparators="None">
                    <CustomListItem>
                        <Panel class="sapUiSmallMarginBottom">
                            <headerToolbar>
                                <Toolbar>
                                    <Title text="#{recommendationResult>rank} \u2014 {recommendationResult>lever}" level="H5" />
                                    <ToolbarSpacer />
                                    <ObjectStatus text="{recommendationResult>risk}" state="{recommendationResult>riskState}" />
                                    <ObjectStatus text="\u2713 AI Recommended" state="Success" visible="{recommendationResult>isTopRecommendation}" class="sapUiSmallMarginStart" />
                                </Toolbar>
                            </headerToolbar>
                            <HBox class="sapUiSmallMarginBottom">
                                <VBox class="sapUiMediumMarginEnd"><Label text="Coverage" /><Text text="{recommendationResult>coverage}" /></VBox>
                                <VBox class="sapUiMediumMarginEnd"><Label text="Cost" /><Text text="{recommendationResult>cost}" /></VBox>
                                <VBox><Label text="Risk" /><ObjectStatus text="{recommendationResult>risk}" state="{recommendationResult>riskState}" /></VBox>
                            </HBox>
                            <VBox class="sapUiSmallMarginBottom">
                                <Label text="Go Scenario" />
                                <Text text="{recommendationResult>goScenario}" wrapping="true" />
                            </VBox>
                            <VBox class="sapUiSmallMarginBottom">
                                <Label text="No-Go Fallback" />
                                <Text text="{recommendationResult>noGo}" wrapping="true" />
                            </VBox>
                            <Input placeholder="Comment (optional)..." class="sapUiSmallMarginBottom" />
                            <HBox>
                                <Button text="Approve" press=".onRecommendationAction" type="Accept" class="sapUiTinyMarginEnd" />
                                <Button text="Reject" press=".onRecommendationAction" type="Reject" />
                            </HBox>
                        </Panel>
                    </CustomListItem>
                </List>
            </Panel>

            <!-- AI NARRATIVE OVERVIEW -->
            <Panel class="sapUiSmallMarginBottom" visible="{= !!${recommendationResult>/aiNarrative} }">
                <headerToolbar>
                    <Toolbar>
                        <Title text="AI NARRATIVE OVERVIEW" level="H4" />
                        <ToolbarSpacer />
                        <Text text="Generated by Orchestration LLM" />
                    </Toolbar>
                </headerToolbar>
                <core:HTML content="{= '&lt;div>' + ${recommendationResult>/aiNarrative} + '&lt;/div>' }" />
            </Panel>

        </VBox>
    </VBox>
</core:FragmentDefinition>
